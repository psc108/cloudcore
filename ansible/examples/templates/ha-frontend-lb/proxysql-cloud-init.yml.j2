#cloud-config
# ProxySQL + NGINX/Keepalived, co-located (haFullStack-LLD.md §1/§2).
# Ansible port of
# examples/ha-frontend-lb/files/proxysql-cloud-init.yaml.tftpl — same
# content, Terraform's dollar-brace/percent-brace-for interpolation and
# indent() replaced with Jinja2's double-brace/percent-brace-for syntax
# and the `indent` filter.
apt_preserve_sources_list: true
bootcmd:
  - |
    cat > /etc/apt/sources.list <<'EOF'
    deb [trusted=yes] http://192.168.100.1:8090/jammy/apt-repo ./
    EOF

package_update: true
packages:
  - curl
  - ca-certificates
  - mysql-client
  - nginx
  - keepalived

write_files:
  - path: /usr/local/sbin/install-proxysql.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      set -euo pipefail

      DEB=/tmp/proxysql.deb
      curl -fsSL http://192.168.100.1:8090/jammy/artifacts/proxysql.deb -o "$DEB"
      echo "{{ proxysql_deb_sha256 }}  $DEB" | sha256sum -c -
      dpkg -i "$DEB" || apt-get install -f -y
      systemctl enable --now proxysql

      for i in $(seq 1 30); do
        mysql -h127.0.0.1 -P6032 -uadmin -padmin -e "SELECT 1" >/dev/null 2>&1 && break
        sleep 2
      done

      mysql -h127.0.0.1 -P6032 -uadmin -padmin <<SQL
{% for ip in mysql_ips %}
      INSERT INTO mysql_servers (hostgroup_id, hostname, port, use_ssl) VALUES (20, '{{ ip }}', 3306, 1);
{% endfor %}

      INSERT INTO mysql_group_replication_hostgroups
        (writer_hostgroup, backup_writer_hostgroup, reader_hostgroup, offline_hostgroup, active, max_writers, writer_is_also_reader, max_transactions_behind)
      VALUES (10, 12, 20, 9999, 1, 1, 1, 100);

      INSERT INTO mysql_query_rules (rule_id, match_pattern, destination_hostgroup, apply)
      VALUES (1, '^SELECT.*', 20, 1);

      UPDATE global_variables SET variable_value='proxysql_monitor' WHERE variable_name='mysql-monitor_username';
      UPDATE global_variables SET variable_value='{{ monitor_password }}' WHERE variable_name='mysql-monitor_password';

      INSERT INTO mysql_users (username, password, default_hostgroup) VALUES ('appuser', '{{ app_password }}', 10);
      INSERT INTO mysql_users (username, password, default_hostgroup) VALUES ('keystone', '{{ keystone_password }}', 10);
      INSERT INTO mysql_users (username, password, default_hostgroup) VALUES ('root', '{{ root_password }}', 10);

      LOAD MYSQL VARIABLES TO RUNTIME;
      LOAD MYSQL SERVERS TO RUNTIME;
      LOAD MYSQL QUERY RULES TO RUNTIME;
      LOAD MYSQL USERS TO RUNTIME;
      SAVE MYSQL VARIABLES TO DISK;
      SAVE MYSQL SERVERS TO DISK;
      SAVE MYSQL QUERY RULES TO DISK;
      SAVE MYSQL USERS TO DISK;
      SQL

  - path: /usr/local/sbin/setup-proxysql-tls.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      set -euo pipefail

      LOCAL_IP=$(hostname -I | awk '{print $1}')

      curl -fsSL http://192.168.100.1:8090/jammy/artifacts/step-cli.deb -o /tmp/step-cli.deb
      echo "{{ step_cli_deb_sha256 }}  /tmp/step-cli.deb" | sha256sum -c -
      dpkg -i /tmp/step-cli.deb || apt-get install -f -y

      for i in $(seq 1 180); do
        curl -sf "http://{{ ca_ip }}:8080/root_ca.crt" -o /tmp/root_ca.crt \
          && curl -sf "http://{{ ca_ip }}:8080/intermediate_ca.crt" -o /tmp/intermediate_ca.crt \
          && break
        sleep 5
      done

      mkdir -p /etc/proxysql/ssl
      step ca certificate "$LOCAL_IP" /etc/proxysql/ssl/cert.pem /etc/proxysql/ssl/key.pem \
        --san "$LOCAL_IP" --san "{{ vip_address }}" \
        --ca-url "https://{{ ca_ip }}:8443" --root /tmp/root_ca.crt \
        --provisioner admin --provisioner-password-file <(echo -n "{{ ca_provisioner_password }}") \
        --force
      cp /tmp/root_ca.crt /etc/proxysql/ssl/ca.pem
      cp /tmp/root_ca.crt /etc/proxysql/ssl/root_ca.pem
      chown -R proxysql:proxysql /etc/proxysql/ssl
      chmod 600 /etc/proxysql/ssl/key.pem

      systemctl stop proxysql
      cp /etc/proxysql/ssl/cert.pem /var/lib/proxysql/proxysql-cert.pem
      cp /etc/proxysql/ssl/key.pem /var/lib/proxysql/proxysql-key.pem
      cp /etc/proxysql/ssl/ca.pem /var/lib/proxysql/proxysql-ca.pem
      chown proxysql:proxysql /var/lib/proxysql/proxysql-*.pem
      systemctl start proxysql

      for i in $(seq 1 30); do
        mysql -h127.0.0.1 -P6032 -uadmin -padmin -e "SELECT 1" >/dev/null 2>&1 && break
        sleep 2
      done

      mysql -h127.0.0.1 -P6032 -uadmin -padmin <<SQL
      UPDATE global_variables SET variable_value='/etc/proxysql/ssl/ca.pem' WHERE variable_name='mysql-ssl_p2s_ca';
      UPDATE global_variables SET variable_value='/etc/proxysql/ssl/cert.pem' WHERE variable_name='mysql-ssl_p2s_cert';
      UPDATE global_variables SET variable_value='/etc/proxysql/ssl/key.pem' WHERE variable_name='mysql-ssl_p2s_key';
      LOAD MYSQL VARIABLES TO RUNTIME;
      SAVE MYSQL VARIABLES TO DISK;
      SQL

      cat > /etc/systemd/system/step-renew-proxysql.service <<EOF
      [Unit]
      Description=step-ca certificate auto-renewal daemon (ProxySQL)
      [Service]
      ExecStart=/usr/bin/step ca renew /etc/proxysql/ssl/cert.pem /etc/proxysql/ssl/key.pem --daemon --force --ca-url "https://{{ ca_ip }}:8443" --root /etc/proxysql/ssl/root_ca.pem --exec "cp /etc/proxysql/ssl/cert.pem /var/lib/proxysql/proxysql-cert.pem && cp /etc/proxysql/ssl/key.pem /var/lib/proxysql/proxysql-key.pem && chown proxysql:proxysql /var/lib/proxysql/proxysql-cert.pem /var/lib/proxysql/proxysql-key.pem && systemctl restart proxysql"
      Restart=always
      EOF
      systemctl daemon-reload
      systemctl enable --now step-renew-proxysql

  - path: /etc/nginx/sites-available/default
    content: |
      {{ nginx_conf | indent(6) }}
  - path: /etc/nginx/stream.conf
    content: |
      {{ nginx_stream_conf | indent(6) }}
  - path: /etc/keepalived/keepalived.conf.template
    content: |
      vrrp_instance VI_1 {
          state {{ keepalived_state }}
          interface __IFACE__
          virtual_router_id {{ vrrp_router_id }}
          priority {{ keepalived_priority }}
          advert_int 1
          authentication {
              auth_type PASS
              auth_pass {{ vrrp_auth_pass }}
          }
          virtual_ipaddress {
              {{ vip_address }}/24
          }
      }
  - path: /usr/local/sbin/render-keepalived-conf.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      set -euo pipefail
      IFACE=$(ip -o link show up | awk -F': ' '$2!="lo"{print $2; exit}')
      sed "s/__IFACE__/$IFACE/" /etc/keepalived/keepalived.conf.template > /etc/keepalived/keepalived.conf

  - path: /usr/local/sbin/setup-nginx-tls.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      set -euo pipefail

      curl -fsSL http://192.168.100.1:8090/jammy/artifacts/step-cli.deb -o /tmp/step-cli.deb
      echo "{{ step_cli_deb_sha256 }}  /tmp/step-cli.deb" | sha256sum -c -
      dpkg -i /tmp/step-cli.deb || apt-get install -f -y

      for i in $(seq 1 180); do
        curl -sf "http://{{ ca_ip }}:8080/root_ca.crt" -o /tmp/root_ca.crt \
          && curl -sf "http://{{ ca_ip }}:8080/intermediate_ca.crt" -o /tmp/intermediate_ca.crt \
          && break
        sleep 5
      done

      mkdir -p /etc/nginx/ssl
      step ca certificate "{{ vip_address }}" /etc/nginx/ssl/cert.pem /etc/nginx/ssl/key.pem \
        --ca-url "https://{{ ca_ip }}:8443" --root /tmp/root_ca.crt \
        --provisioner admin --provisioner-password-file <(echo -n "{{ ca_provisioner_password }}") \
        --force
      cat /tmp/root_ca.crt /tmp/intermediate_ca.crt > /etc/nginx/ssl/ca.pem
      cp /tmp/root_ca.crt /etc/nginx/ssl/root_ca.pem
      chmod 600 /etc/nginx/ssl/key.pem

      cat > /etc/systemd/system/step-renew-nginx.service <<EOF
      [Unit]
      Description=step-ca certificate auto-renewal daemon (NGINX)
      [Service]
      ExecStart=/usr/bin/step ca renew /etc/nginx/ssl/cert.pem /etc/nginx/ssl/key.pem --daemon --force --ca-url "https://{{ ca_ip }}:8443" --root /etc/nginx/ssl/root_ca.pem --exec "systemctl reload nginx"
      Restart=always
      EOF
      systemctl daemon-reload
      systemctl enable --now step-renew-nginx

runcmd:
  - /usr/local/sbin/install-proxysql.sh
  - /usr/local/sbin/setup-proxysql-tls.sh
  - /usr/local/sbin/render-keepalived-conf.sh
  - /usr/local/sbin/setup-nginx-tls.sh
  - echo "include /etc/nginx/stream.conf;" >> /etc/nginx/nginx.conf
  - nginx -t
  - systemctl restart nginx
  - systemctl enable --now keepalived
