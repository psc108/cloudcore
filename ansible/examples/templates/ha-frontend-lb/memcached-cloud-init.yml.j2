#cloud-config
# memcached — Fernet token-validation cache for the Keystone tier. Both
# nodes are genuinely independent (no clustering/replication between
# them); Keystone's own oslo.cache client is responsible for sharding
# which key goes to which server given the list of both. Access is
# already scoped to the keystone security group alone at the network
# layer (haFullStack-LLD.md §3.3.1) — 0.0.0.0 here, not a hardcoded
# detected IP, matches the same bind-address reasoning used for MySQL:
# the real bridged IP isn't known until runtime, and the security group
# is what actually restricts who can reach it, not the bind address.
package_update: true
packages:
  - memcached
  - promtail

write_files:
  - path: /etc/memcached.conf
    content: |
      -d
      logfile /var/log/memcached.log
      -m 64
      -p 11211
      -u memcache
      -l 0.0.0.0

  # Centralized logging (haFullStack-LLD.md §12) — see
  # ca-cloud-init.yml.j2's own comment for why this uses the
  # indent-filter pattern, not a raw include directive.
  - path: /etc/promtail/config.yml
    content: |
      {{ promtail_config | indent(6) }}

runcmd:
  - systemctl restart memcached
  # F-073: promtail's own package postinst auto-starts the
  # service immediately after install, before this runcmd
  # block gets a chance to fix up __HOSTNAME__ or grant the
  # "adm" group — stop it first so the only real start
  # happens against the corrected config, same class of
  # first-boot race already handled for Grafana's own admin
  # password (logging-cloud-init.yml.j2).
  - systemctl stop promtail || true
  - sed "s/__HOSTNAME__/$(hostname)/" -i /etc/promtail/config.yml
  # F-072: promtail's own user isn't a member of "adm" by
  # default, needed to read root:adm 0640
  # /var/log/cloud-init-output.log.
  - usermod -aG adm promtail
  - systemctl enable --now promtail
