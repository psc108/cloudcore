  # No WSGIDaemonProcess/service pool involved here — this is a one-shot
  # API client, not a listener, so none of F-051's memory concerns apply.
  # Runs against Keystone's own local :35357 (mTLS — :5000 no longer
  # exists, per direct instruction to close every plaintext Keystone
  # listener, including boot-time tooling). import_p3.py's SESSION.cert
  # (requests/urllib3) can't load a passphrase-protected key directly, so
  # this script decrypts a throwaway, root-only copy of this node's own
  # already-issued key into /run (tmpfs, never touches persistent disk)
  # right before the import and removes it immediately after — the
  # encrypted original on /etc/keystone/server.key is untouched.
  # Retries each import a few times: both Keystone nodes run this same
  # script concurrently, and import_p3.py's own "does this already
  # exist" check has a real (if narrow) race window between the two
  # nodes — a retry after a losing 409 just re-checks state and finds
  # the object the other node already created.
  - path: /usr/local/sbin/setup-keystone-roles.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      set -euo pipefail

      # Keystone has no data replication of its own — every role/domain/
      # user this script imports lives entirely in the shared 'keystone'
      # MySQL database both nodes already connect to (same as db_sync/
      # bootstrap above, which is why those two are safe to run
      # concurrently on both nodes: proper idempotent SQL against one
      # shared backing store). This script's own check-then-create
      # pattern is NOT concurrency-safe the same way — running it from
      # both nodes at once produces real 409s racing to create the same
      # role/domain/user, confirmed directly. Per direct instruction:
      # only the first node (modules/instance-group always names one
      # "-01", per its own documented convention: "Scaling up adds
      # instances; scaling down removes the highest-numbered ones" — -01
      # is guaranteed to exist as long as any instance does) actually
      # runs the import; every other node is a no-op here, relying on
      # -01 having already populated the shared database.
      case "$(hostname)" in
        *-01) ;;
        *) echo "setup-keystone-roles.sh: not the -01 node, skipping (roles/domains are shared via MySQL, not per-node)"; exit 0 ;;
      esac

      cd /usr/local/lib/keystone-import

      # This node's own cert only carries SANs for its own private IP and
      # the VIP (setup-keystone-tls.sh's --san list) — no 127.0.0.1 entry
      # — so hostname verification against "127.0.0.1" fails even with a
      # perfectly valid cert/key pair (confirmed directly:
      # "hostname '127.0.0.1' doesn't match either of '<ip>', '<vip>'").
      # Connect via the node's own real IP instead, which the cert
      # actually covers.
      LOCAL_IP=$(hostname -I | awk '{print $1}')

      # Decrypted once, up front, as a real temp file — curl's --key (and
      # import_p3.py's SESSION.cert below) both need an actual seekable
      # file path, not a process-substitution pipe, to read a private key
      # reliably.
      TMP_KEY=$(mktemp /run/keystone-import-key.XXXXXX)
      trap 'rm -f "$TMP_KEY"' EXIT
      openssl pkey -in /etc/keystone/server.key -passin pass:'{{ admin_password }}' -out "$TMP_KEY"
      chmod 600 "$TMP_KEY"

      for i in $(seq 1 60); do
        curl -sf --cacert /etc/keystone/ca.crt --cert /etc/keystone/server.crt --key "$TMP_KEY" \
          "https://$LOCAL_IP:35357/api/idm/v3" >/dev/null 2>&1 && break
        sleep 5
      done

      export OS_AUTH_URL="https://$LOCAL_IP:35357/api/idm/v3"
      export OS_USERNAME=admin
      export OS_PASSWORD='{{ admin_password }}'

      roles_ok=false
      for i in 1 2 3; do
        python3 import_p3.py -i roles.yml -k "$OS_AUTH_URL" -u "$OS_USERNAME" \
          -p "$OS_PASSWORD" -c /etc/keystone/root_ca.crt \
          -C /etc/keystone/server.crt -K "$TMP_KEY" && { roles_ok=true; break; }
        sleep 10
      done
      $roles_ok || echo "setup-keystone-roles.sh: roles.yml import did not complete after 3 attempts" >&2

      domain_ok=false
      for i in 1 2 3; do
        python3 import_p3.py -i system_domain.yml -k "$OS_AUTH_URL" -u "$OS_USERNAME" \
          -p "$OS_PASSWORD" -c /etc/keystone/root_ca.crt \
          -C /etc/keystone/server.crt -K "$TMP_KEY" \
          -e password,{{ keystone_system_domain_password }} && { domain_ok=true; break; }
        sleep 10
      done
      $domain_ok || echo "setup-keystone-roles.sh: system_domain.yml import did not complete after 3 attempts" >&2

      $roles_ok && $domain_ok

  - path: /usr/local/sbin/setup-keystone.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      set -euo pipefail

      mkdir -p /etc/keystone/fernet-keys
      mv /root/fernet-key-0 /etc/keystone/fernet-keys/0
      mv /root/fernet-key-1 /etc/keystone/fernet-keys/1
      chown -R keystone:keystone /etc/keystone/fernet-keys
      chmod 600 /etc/keystone/fernet-keys/0 /etc/keystone/fernet-keys/1

      mv /root/keystone-policy.json /etc/keystone/policy.json
      chown keystone:keystone /etc/keystone/policy.json
      chmod 644 /etc/keystone/policy.json

      # Wait for the shared MySQL path (VIP -> NGINX stream{} -> ProxySQL
      # -> MySQL) to actually accept the root connection before running
      # db_sync — cloud-init on every tier runs concurrently, so
      # NGINX/ProxySQL/MySQL may not be ready yet at this exact moment.
      # Matches this stack's established pattern (see mysql-cloud-init.yaml.tftpl's
      # own wait loop) of an explicit retry rather than relying on
      # Terraform apply order, which doesn't wait for cloud-init to finish
      # on any other node either.
      for i in $(seq 1 180); do
        mysql -h "{{ vip_address }}" -P 3306 -u root -p'{{ root_password }}' \
          -e "SELECT 1" >/dev/null 2>&1 && break
        sleep 5
      done

      # Per direct instruction: keystone.conf's [database] connection uses
      # root (the "highest order" account), not a scoped 'keystone' user,
      # against the same 'keystone' schema mysql-cloud-init.yaml.tftpl
      # already creates. Routed through the VIP -> ProxySQL path, same as
      # every other app-level connection in this stack (root@'%' exists
      # specifically for this — see locals.tf's mysql_root_password
      # comment) rather than a direct single-node address, so this keeps
      # working across a MySQL primary failover.
      #
      # This whole script only runs once per instance — it's invoked from
      # cloud-init's runcmd (see the bottom of this file), which cloud-init
      # tracks per instance-id and never re-executes on a simple reboot of
      # the same instance, only on a genuinely new/rebuilt one. No extra
      # guard needed here for that.
      python3 - <<'PYEOF'
      import configparser
      c = configparser.ConfigParser(strict=False)
      c.read('/etc/keystone/keystone.conf')
      c['database']['connection'] = 'mysql+pymysql://root:{{ root_password }}@{{ vip_address }}:3306/keystone'
      if 'cache' not in c:
          c['cache'] = {}
      c['cache']['enabled'] = 'true'
      c['cache']['backend'] = 'dogpile.cache.memcached'
      c['cache']['memcache_servers'] = '{{ memcached_servers_csv }}'
      with open('/etc/keystone/keystone.conf', 'w') as f:
          c.write(f)
      PYEOF
      chown keystone:keystone /etc/keystone/keystone.conf

      keystone-manage db_sync

      # admin/var.admin_password — this stack's shared admin/service
      # credential (haFullStack-LLD.md §3.3.1, variables.tf). Per direct
      # instruction, every plaintext Keystone listener closes and the
      # catalog now points at the real production convention: :35357,
      # keystone-wsgi-admin, mounted at /api/idm — a genuinely separate
      # WSGI app from keystone-wsgi-public, not just a port-number
      # convention (confirmed directly against python3-keystone's own
      # .deb). All three URLs point at the same listener — this Lab has
      # no distinct admin/internal network to separate them onto, and
      # :443 is already the frontend tier's own client-facing port on
      # this same VIP, so it's not an option here regardless.
      #
      # --bootstrap-username/-project-name/-role-name/-service-name are
      # deliberately omitted — checked keystone/cmd/cli.py directly:
      # they default to admin/admin/admin/keystone respectively, exactly
      # what this project's own real bootstrap command already relies on
      # implicitly, so passing them explicitly was pure noise.
      # --bootstrap-region-id is NOT a default-backed omission, though —
      # checked bootstrap.py directly: without it, no region object is
      # created at all and catalog endpoints get no region_id, a real
      # difference from this project's own convention, not a cosmetic
      # one. RegionOne per direct instruction.
      keystone-manage bootstrap \
        --bootstrap-password '{{ admin_password }}' \
        --bootstrap-admin-url "https://{{ vip_address }}:35357/api/idm/v3" \
        --bootstrap-public-url "https://{{ vip_address }}:35357/api/idm/v3" \
        --bootstrap-internal-url "https://{{ vip_address }}:35357/api/idm/v3" \
        --bootstrap-region-id RegionOne

  # env.sh — OpenStack CLI client environment, sourced by root/ecs/ubuntu
  # (runcmd below symlinks it into each user's home directory). Lives
  # under /etc/openstack/, NOT /etc/keystone/ — the latter is
  # keystone:keystone 0750 (package default), so non-keystone-group users
  # like ecs can't even traverse into it to reach a 0644 file inside,
  # confirmed directly ("Permission denied" sourcing the symlink as ecs).
  # OS_AUTH_URL points at the VIP's :35357 mTLS listener (/api/idm path),
  # not any one keystone node's own IP — the VIP is already a static
  # value known at Terraform-render time (var.vip_address), so no
  # runtime IP-discovery step (e.g. a systemd oneshot) is needed here; a
  # fixed per-node IP would also break this file on failover, defeating
  # the point of the HA VIP. OS_PASSWORD matches the bootstrap credential
  # above (both var.admin_password) — this Lab's shared, documented
  # placeholder, not a new secret. Since :5000 is gone, a plain-HTTP CLI
  # path no longer exists — OS_CERT/OS_KEY point at a dedicated "ecs"
  # client identity issued by the same CA (setup-keystone-tls.sh below),
  # the same mechanism the backend tier already uses successfully against
  # this exact listener (haFullStack-LLD.md §5.7). Deliberately an
  # *unencrypted* key, unlike the node's own server key — this is read
  # directly by python-openstackclient/requests, which (like
  # import_p3.py's SESSION.cert) has no way to supply a key passphrase.
  - path: /etc/openstack/env.sh
    permissions: '0644'
    content: |
      export OS_USERNAME=admin
      export OS_PASSWORD='{{ admin_password }}'
      export OS_PROJECT_NAME=admin
      export OS_USER_DOMAIN_NAME=Default
      export OS_PROJECT_DOMAIN_NAME=Default
      export OS_AUTH_URL=https://{{ vip_address }}:35357/api/idm/v3
      export OS_IDENTITY_API_VERSION=3
      export OS_CACERT=/etc/openstack/ca.pem
      export OS_CERT=/etc/openstack/ecs-cert.pem
      export OS_KEY=/etc/openstack/ecs-key.pem
      export no_proxy={{ vip_address }}

  # TLS/mTLS (haFullStack-LLD.md §5.3.1). Per direct instruction, this
  # matches this project's own real-world Keystone Apache convention —
  # the classic OpenStack admin port (35357), keystone-wsgi-admin (a
  # genuinely separate WSGI app from keystone-wsgi-public — confirmed
  # directly by extracting python3-keystone's own .deb: it calls
  # initialize_admin_application(), not initialize_public_application();
  # an earlier assumption in this file that "modern Keystone has no
  # separate admin WSGI script" was wrong), mounted at /api/idm rather
  # than root, and flat /etc/keystone/server.{crt,key} cert paths (this
  # project's own convention, not nested under ssl/) with a separate
  # SSLCertificateChainFile. **Not** bound to :443 — confirmed directly
  # that's already the frontend tier's own client-facing HTTPS port on
  # this same VIP (nginx-frontend.conf.tftpl); binding a second, unrelated
  # listener to the identical port on the same node would collide.
  # :35357 alone serves the identical app/path either way, and per
  # direct instruction this traffic (13 backend microservices talking to
  # Keystone) never needs to be reachable on the same port real end
  # users hit — it stays inside the backend's own bridge-subnet-scoped
  # security group either way, same as every other east-west path in
  # this stack.
  #
  # The package's own plain :5000 vhost is disabled below, per direct
  # instruction to close every plaintext Keystone listener.
  #
  # SSLCACertificateFile is the root+intermediate chain concatenated,
  # not just the root — confirmed necessary the same way RabbitMQ's
  # Erlang SSL stack needed it (see haFullStack-Findings-Log.md);
  # Apache/OpenSSL's own chain verification of the client cert needs the
  # intermediate available locally too. SSLCertificateChainFile is a
  # distinct directive serving a different purpose — the intermediate(s)
  # completing *this node's own* certificate's chain of trust, sent to
  # the client during the handshake — so it holds just the intermediate,
  # not root+intermediate.
  #
  # The server key is passphrase-protected with var.admin_password (this
  # project's own real-world convention, per direct instruction — the
  # same pattern RabbitMQ's server.key now uses) via Apache's
  # SSLPassPhraseDialog exec: mechanism, which runs
  # /etc/keystone/server.key.password.sh once at startup/reload to
  # obtain the passphrase rather than prompting interactively (which
  # would hang a boot with no console attached). Path/filename per
  # direct instruction.
  - path: /usr/local/sbin/setup-keystone-tls.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      set -euo pipefail

      LOCAL_IP=$(hostname -I | awk '{print $1}')

      curl -fsSL http://192.168.100.1:8090/jammy/artifacts/step-cli.deb -o /tmp/step-cli.deb
      echo "{{ step_cli_deb_sha256 }}  /tmp/step-cli.deb" | sha256sum -c -
      dpkg -i /tmp/step-cli.deb || apt-get install -f -y

      for i in $(seq 1 180); do
        curl -sf "http://{{ ca_ip }}:8080/root_ca.crt" -o /tmp/root_ca.crt \
          && curl -sf "http://{{ ca_ip }}:8080/intermediate_ca.crt" -o /tmp/intermediate_ca.crt \
          && break
        sleep 5
      done

      step ca certificate "$LOCAL_IP" /etc/keystone/server.crt /etc/keystone/server.key \
        --san "$LOCAL_IP" --san "{{ vip_address }}" \
        --ca-url "https://{{ ca_ip }}:8443" --root /tmp/root_ca.crt \
        --provisioner admin --provisioner-password-file <(echo -n "{{ ca_provisioner_password }}") \
        --force
      cp /tmp/intermediate_ca.crt /etc/keystone/server_chain.crt
      cat /tmp/root_ca.crt /tmp/intermediate_ca.crt > /etc/keystone/ca.crt
      cp /tmp/root_ca.crt /etc/keystone/root_ca.crt
      chown keystone:keystone /etc/keystone/server.crt /etc/keystone/server.key /etc/keystone/server_chain.crt /etc/keystone/ca.crt /etc/keystone/root_ca.crt
      chmod 600 /etc/keystone/server.key

      # server.key -> `openssl pkey`, not the key-type-specific `openssl
      # rsa`/`openssl ec` — step-ca's default provisioner issues an EC
      # key, and pkey handles either uniformly.
      # -in and -out must NOT be the same path — openssl truncates -out
      # before it's finished reading -in, corrupting the key (confirmed
      # directly, same failure mode as RabbitMQ's identical mistake).
      # Write to a temp file, then move it into place.
      openssl pkey -aes256 -in /etc/keystone/server.key -out /etc/keystone/server.key.enc \
        -passout pass:'{{ admin_password }}'
      mv /etc/keystone/server.key.enc /etc/keystone/server.key
      chown keystone:keystone /etc/keystone/server.key
      chmod 600 /etc/keystone/server.key

      cat > /etc/keystone/server.key.password.sh <<'EOF'
      #!/bin/sh
      echo "{{ admin_password }}"
      EOF
      chown keystone:keystone /etc/keystone/server.key.password.sh
      chmod 700 /etc/keystone/server.key.password.sh

      # Plain-content password file for `step ca renew --password-file`
      # below — distinct from server.key.password.sh above (an
      # executable Apache SSLPassPhraseDialog exec: target, not a file
      # step-cli's own --password-file flag can read directly). Without
      # this, step ca renew has no way to decrypt the already-encrypted
      # server.key to prove possession for the renewal CSR and fails
      # immediately with "error loading private key: : no such device or
      # address" on every single invocation, confirmed directly (F-070,
      # haFullStack-Findings-Log.md) — Restart=always exhausts systemd's
      # burst limit within seconds and the unit ends up permanently
      # failed, silently breaking auto-renewal from the very first boot.
      echo -n "{{ admin_password }}" > /etc/keystone/server.key.passfile
      chown keystone:keystone /etc/keystone/server.key.passfile
      chmod 600 /etc/keystone/server.key.passfile

      # A dedicated "ecs" CLI identity for env.sh — see env.sh's own
      # comment above. Deliberately unencrypted (no passphrase): consumed
      # directly by python-openstackclient/requests, which has no key-
      # password mechanism, unlike Apache's own server key above. SAN
      # doesn't matter here — this is a client-only identity, never
      # presented as anyone's server cert, so nothing validates it.
      step ca certificate "ecs-cli" /etc/openstack/ecs-cert.pem /etc/openstack/ecs-key.pem \
        --san "ecs-cli" \
        --ca-url "https://{{ ca_ip }}:8443" --root /tmp/root_ca.crt \
        --provisioner admin --provisioner-password-file <(echo -n "{{ ca_provisioner_password }}") \
        --force
      cp /etc/keystone/ca.crt /etc/openstack/ca.pem
      chmod 644 /etc/openstack/ecs-cert.pem /etc/openstack/ecs-key.pem /etc/openstack/ca.pem

      a2enmod ssl

      # Ubuntu's keystone package enables its own plain :5000 vhost as a
      # SITE named "keystone" (/etc/apache2/sites-available/keystone.conf)
      # — confirmed directly (an earlier guess assuming a conf snippet
      # named "wsgi-keystone" was wrong and silently disabled nothing).
      # Disabled here since it's plaintext and every plaintext Keystone
      # listener closes, per direct instruction.
      if [ -e /etc/apache2/sites-enabled/keystone.conf ]; then
        a2dissite keystone
      fi

      # SSLPassPhraseDialog is a server-level (mod_ssl global) directive —
      # confirmed directly: Apache refuses to start with "SSLPassPhraseDialog
      # cannot occur within <VirtualHost> section" if placed inside one, so
      # it lives in its own conf-available fragment instead of inline in
      # keystone-admin.conf below.
      cat > /etc/apache2/conf-available/keystone-ssl-passphrase.conf <<'EOF'
      SSLPassPhraseDialog exec:/etc/keystone/server.key.password.sh
      EOF
      a2enconf keystone-ssl-passphrase

      # Quoted heredoc (<<'EOF') so bash performs no expansion of its own —
      # the doubled-up escapes below are for templatefile()'s own
      # interpolation syntax (this file is rendered by Terraform before
      # cloud-init ever sees it), so Apache's APACHE_LOG_DIR and
      # mod_wsgi's GLOBAL group reach the actual config file intact. No
      # `Listen 443` here — mod_ssl's own ports.conf already declares
      # that (guarded by <IfModule ssl_module>, active now that a2enmod
      # ssl above has run); this vhost isn't bound to :443 anyway (see
      # the port-conflict comment above), only :35357 needs its own
      # explicit Listen.
      cat > /etc/apache2/sites-available/keystone-admin.conf <<'EOF'
      Listen 35357

      <VirtualHost *:35357>
        SSLEngine on
        SSLCertificateFile /etc/keystone/server.crt
        SSLCertificateChainFile /etc/keystone/server_chain.crt
        SSLCertificateKeyFile /etc/keystone/server.key
        SSLCACertificateFile /etc/keystone/ca.crt
        SSLVerifyClient require
        SSLVerifyDepth 2
        SSLProtocol -all +TLSv1.2 +TLSv1.3

        WSGIDaemonProcess keystone-admin processes=3 threads=1 user=keystone group=keystone display-name=keystone-admin
        WSGIProcessGroup keystone-admin
        WSGIScriptAlias /api/idm /usr/bin/keystone-wsgi-admin
        WSGIApplicationGroup %{GLOBAL}

        <Directory /usr/bin>
          Require all granted
        </Directory>

        ErrorLog ${APACHE_LOG_DIR}/keystone-admin-error.log
        LogLevel warn
        CustomLog ${APACHE_LOG_DIR}/keystone-admin-access.log combined
      </VirtualHost>
      EOF
      a2ensite keystone-admin

      # Positional <crt> <key> must come immediately after the subcommand,
      # before any flags — confirmed directly: flags-then-positional
      # fails with "too many positional arguments were provided". No
      # `step ca bootstrap` has been run here, so --ca-url/--root are
      # passed explicitly, same as the issuance call above. Re-encrypts
      # the freshly-renewed (and therefore freshly-unencrypted) key before
      # restarting Apache, same reasoning as RabbitMQ's renew hook.
      cat > /etc/systemd/system/step-renew.service <<EOF
      [Unit]
      Description=step-ca certificate auto-renewal daemon
      [Service]
      ExecStart=/usr/bin/step ca renew /etc/keystone/server.crt /etc/keystone/server.key --password-file /etc/keystone/server.key.passfile --daemon --force --ca-url "https://{{ ca_ip }}:8443" --root /etc/keystone/root_ca.crt --exec "openssl pkey -aes256 -in /etc/keystone/server.key -passin pass:'{{ admin_password }}' -out /etc/keystone/server.key.enc -passout pass:'{{ admin_password }}' && mv /etc/keystone/server.key.enc /etc/keystone/server.key && systemctl restart apache2"
      Restart=always
      EOF
      systemctl daemon-reload
      systemctl enable --now step-renew

      # a2ensite/a2dissite/a2enconf above only change what WOULD load on
      # the next start/reload — they don't touch the apache2 process the
      # packages: stage already auto-started (still serving the OLD,
      # now-disabled :5000-only config). Without this restart here,
      # setup-keystone-roles.sh (next in runcmd) hits :35357 with nothing
      # listening yet — confirmed directly: "Connection refused" on every
      # one of its 60 retries, since nothing in this boot ever reloads
      # apache2 before that script's own readiness loop gives up. Restart
      # here, not just once at the very end of runcmd, so :35357 is
      # actually live before anything downstream depends on it.
      systemctl restart apache2

runcmd:
  # F-073/F-072 promtail fix, first — before setup-keystone.sh starts
  # Apache. See ca-cloud-init.yml.j2's own runcmd comment for the full
  # reasoning (F-076, haFullStack-Findings-Log.md).
  - systemctl stop promtail || true
  - sed "s/__HOSTNAME__/$(hostname)/" -i /etc/promtail/config.yml
  - usermod -aG adm promtail
  - systemctl enable --now promtail
  - /usr/local/sbin/setup-keystone.sh
  - /usr/local/sbin/setup-keystone-tls.sh
  - /usr/local/sbin/setup-keystone-roles.sh
  - |
    for u in root ecs ubuntu; do
      home=$(getent passwd "$u" | cut -d: -f6)
      [ -d "$home" ] || continue
      ln -sf /etc/openstack/env.sh "$home/env.sh"
    done
