#cloud-config
# Keystone identity node — genuinely active-active, no per-node role.
# Both nodes run this identical script: keystone-manage db_sync and
# bootstrap are both safe to run unconditionally and concurrently on
# every node (confirmed directly against a real install — re-running
# either against an already-initialized database is a clean no-op, not a
# duplicate/error), so this needs none of MySQL's bootstrap/joiner
# user_data split (haFullStack-LLD.md §3.3.1). The `keystone` apt package
# already ships Apache + mod_wsgi wired up to listen on :5000 out of the
# box (confirmed directly) — no separate systemd unit or reverse-proxy
# config of our own is needed for the daemon itself.
# apt_preserve_sources_list — without this, cloud-init's own apt-
# configure module regenerates /etc/apt/sources.list right after
# bootcmd runs, silently overwriting the cloudcore-repo rewrite below
# with zero error (confirmed directly, F-042, haFullStack-Findings-Log.md).
# bootcmd points apt at the host-level cloudcore-repo service
# (192.168.100.1:8090, haFullStack.md §14) instead of the real Ubuntu
# mirror; see ca-cloud-init.yaml.tftpl for the full rationale.
apt_preserve_sources_list: true
bootcmd:
  # cloudcore-repo is a host-level, always-on systemd service (not
  # per-project, no build-completion race to wait on like the old
  # NFS-based repo needed) — a plain HTTP GET, no client package to
  # install first the way NFS needed nfs-common, so the old
  # archive.ubuntu.com bootstrap fetch this block used to need is gone
  # entirely, not just relocated.
  - |
    cat > /etc/apt/sources.list <<'EOF'
    deb [trusted=yes] http://192.168.100.1:8090/jammy/apt-repo ./
    EOF

package_update: true
packages:
  - keystone
  - python3-pymysql
  - python3-memcache
  - mysql-client
  - curl
  - ca-certificates
  - python3-requests
  - python3-yaml
  - python3-openstackclient
  - promtail

write_files:
  # Centralized logging (haFullStack-LLD.md §12) — see
  # ca-cloud-init.yml.j2's own comment for why this uses the
  # indent-filter pattern, not a raw include directive.
  - path: /etc/promtail/config.yml
    content: |
      {{ promtail_config | indent(6) }}

  # Identical Fernet key material on both nodes, generated once in
  # Terraform (main.tf's random_id resources) — writing these directly
  # instead of running `keystone-manage fernet_setup` on each node
  # separately, which would generate two different, incompatible key
  # sets. File format confirmed directly: fernet_setup writes the raw
  # base64url key as the file's entire content, no wrapper — exactly
  # random_id's own .b64_url output.
  #
  # Written to a plain root-owned staging path here, NOT directly to
  # /etc/keystone/fernet-keys/ with owner: keystone:keystone — cloud-init's
  # write_files module runs before the packages stage, so the keystone
  # system user doesn't exist yet at this point (confirmed directly: an
  # owner: on one of these entries made write_files fail outright with
  # "Unknown user or group: keystone", which aborts the WHOLE write_files
  # module, silently skipping every other file in this list too —
  # including setup-keystone.sh below). Moved into place with correct
  # ownership in runcmd instead, which runs after packages are installed.
  - path: /root/fernet-key-0
    permissions: '0600'
    content: {{ fernet_key0 }}
  - path: /root/fernet-key-1
    permissions: '0600'
    content: {{ fernet_key1 }}

  # Custom RBAC policy, staged root-owned same as the fernet keys above
  # (and for the same reason — write_files runs before the packages stage,
  # so /etc/keystone doesn't exist and the keystone system user doesn't
  # either yet). Moved into place with correct ownership in
  # setup-keystone.sh below, which runs after packages are installed.
