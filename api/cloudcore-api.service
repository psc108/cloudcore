[Unit]
Description=CloudCore API Server
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/IdeaProjects/CloudProject/api
Environment=CLOUDCORE_API_TOKEN=dev-token
ExecStart=/usr/bin/python3 %h/IdeaProjects/CloudProject/api/server.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
