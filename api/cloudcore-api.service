[Unit]
Description=CloudCore API Server
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/scottp/IdeaProjects/CloudProject/api
Environment=CLOUDCORE_API_TOKEN=dev-token
# ansible-playbook/ansible-galaxy (pip --user, not apt-installed — see
# scripts/install.sh) live in ~/.local/bin, invoked by build_engine.py's
# subprocess calls by bare name. A systemd --user unit's default PATH
# doesn't reliably include it (depends on how the login session that
# started the user manager was established — a desktop login often
# imports it, a headless/SSH-only one may not), so it's set explicitly
# here rather than left to chance.
Environment=PATH=%h/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/usr/bin/python3 /home/scottp/IdeaProjects/CloudProject/api/server.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
