stream {
    upstream proxysql_write {
%{ for ip in proxysql_ips ~}
        server ${ip}:6033 max_fails=3 fail_timeout=10s;
%{ endfor ~}
    }

    server {
        listen 3306;
        proxy_pass proxysql_write;
        proxy_timeout 3s;
        proxy_connect_timeout 2s;
    }

    # TLS passthroughs (haFullStack-LLD.md §5.3.1), TLS-only per direct
    # instruction — RabbitMQ's plain :5672/:15672 and Keystone's plain
    # :5000/:35357 are gone entirely, not kept alongside these. Both
    # RabbitMQ (5671 AMQP, 15671 management) and Keystone (5443) are raw
    # transparent forwards, not proxy_ssl_*-based re-encryption — the TLS
    # handshake negotiates end-to-end between the actual client and the
    # actual backend regardless of this hop, same as MySQL/ProxySQL's
    # in-band upgrade above needing zero NGINX-side TLS awareness.
    upstream rabbitmq_amqp_tls {
%{ for ip in rabbitmq_ips ~}
        server ${ip}:5671 max_fails=3 fail_timeout=10s;
%{ endfor ~}
    }

    server {
        listen 5671;
        proxy_pass rabbitmq_amqp_tls;
        proxy_timeout 3s;
        proxy_connect_timeout 2s;
    }

    # Management HTTPS API — rabbitmq-status.py connects here through the
    # VIP, same as AMQP above. stream{} proxying it (rather than exposing
    # it in NGINX's http{} context) matches how every other raw-TCP
    # backend in this stack is fronted.
    upstream rabbitmq_management_tls {
%{ for ip in rabbitmq_ips ~}
        server ${ip}:15671 max_fails=3 fail_timeout=10s;
%{ endfor ~}
    }

    server {
        listen 15671;
        proxy_pass rabbitmq_management_tls;
        proxy_timeout 3s;
        proxy_connect_timeout 2s;
    }

    upstream keystone_tls {
%{ for ip in keystone_tls_ips ~}
        server ${ip}:5443 max_fails=3 fail_timeout=10s;
%{ endfor ~}
    }

    server {
        listen 5443;
        proxy_pass keystone_tls;
        proxy_timeout 3s;
        proxy_connect_timeout 2s;
    }
}
