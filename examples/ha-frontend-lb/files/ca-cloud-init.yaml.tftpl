#cloud-config
# Single-node step-ca — deliberately not HA (haFullStack-LLD.md §5.1).
# step-ca/step-cli aren't in Ubuntu's default repos, installed from the
# pinned, checksum-verified .debs already cached in the host-level
# cloudcore-repo's artifacts share (haFullStack.md §14) — every
# certificate-requesting node used to curl these individually from
# GitHub (12+ redundant fetches of the same files, F-037's
# network-congestion finding). Every other tier's own cloud-init waits
# for this node to be reachable before requesting its own certificate —
# the same explicit-wait pattern every prior tier used for its own
# bootstrap dependency, not relying on Terraform apply order.
#
# apt_preserve_sources_list — without this, cloud-init's own apt-
# configure module regenerates /etc/apt/sources.list right after
# bootcmd runs, silently overwriting the cloudcore-repo rewrite below
# with zero error (confirmed directly, F-042, haFullStack-Findings-Log.md).
#
# bootcmd (not runcmd/write_files) — cloud-init's earliest hook, the
# only one guaranteed to run before the packages: module below.
# cloudcore-repo (192.168.100.1:8090, haFullStack.md §14) is a
# host-level, always-on service reachable over plain HTTP — unlike the
# old per-project NFS repo this replaces, no client package needs
# installing first, so the "one small bootstrap fetch from the real
# mirror" exception this comment used to describe no longer applies at
# all.
apt_preserve_sources_list: true
bootcmd:
  # cloudcore-repo is a host-level, always-on systemd service (not
  # per-project, no build-completion race to wait on like the old
  # NFS-based repo needed) — a plain HTTP GET, no client package to
  # install first the way NFS needed nfs-common, so the old
  # archive.ubuntu.com bootstrap fetch this block used to need is gone
  # entirely, not just relocated.
  - |
    cat > /etc/apt/sources.list <<'EOF'
    deb [trusted=yes] http://192.168.100.1:8090/jammy/apt-repo ./
    EOF

package_update: true
packages:
  - curl
  - ca-certificates
  - promtail

write_files:
  # Centralized logging (haFullStack-LLD.md §12) — ships this node's own
  # journal + cloud-init-output.log to the host-level Loki service. __HOSTNAME__
  # fixed up in runcmd below, same sed-substitution idiom this stack
  # already uses for __IFACE__/__HOSTNAME__ elsewhere.
  - path: /etc/promtail/config.yml
    content: |
      ${indent(6, promtail_config)}
  - path: /usr/local/sbin/setup-ca.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      set -euo pipefail

      LOCAL_IP=$(hostname -I | awk '{print $1}')

      curl -fsSL http://192.168.100.1:8090/jammy/artifacts/step-ca.deb -o /tmp/step-ca.deb
      curl -fsSL http://192.168.100.1:8090/jammy/artifacts/step-cli.deb -o /tmp/step-cli.deb
      echo "${step_ca_deb_sha256}  /tmp/step-ca.deb" | sha256sum -c -
      echo "${step_cli_deb_sha256}  /tmp/step-cli.deb" | sha256sum -c -
      dpkg -i /tmp/step-ca.deb /tmp/step-cli.deb || apt-get install -f -y

      export STEPPATH=/etc/step-ca
      mkdir -p "$STEPPATH"
      step ca init \
        --name "CloudCore Lab CA" \
        --dns "$LOCAL_IP" \
        --address ":8443" \
        --provisioner admin \
        --password-file <(echo -n "${provisioner_password}") \
        --deployment-type standalone

      echo -n "${provisioner_password}" > /etc/step-ca/password.txt
      chmod 600 /etc/step-ca/password.txt

      # step ca init leaves authority.claims unset, which step-ca defaults
      # to a 24h max/default leaf-cert duration internally — confirmed
      # directly (haFullStack-LLD.md §5.1 originally assumed 90 days,
      # corrected once this was found). That default is fine for a quick
      # Lab smoke test but drifts from what a real On-Prem/AWS PKI would
      # actually run — deliberately set to 365 days (8760h) here instead,
      # so the Lab's own cert lifetime realistically mirrors what those
      # later environments will use, not just what's convenient to test
      # with. Edited before step-ca's first start (below, in runcmd), so
      # no restart is needed for this to take effect — every node's own
      # first `step ca certificate` issuance already gets the new value.
      python3 - <<'PYEOF'
      import json
      with open('/etc/step-ca/config/ca.json') as f:
          cfg = json.load(f)
      cfg['authority']['claims'] = {
          'minTLSCertDuration': '5m',
          'maxTLSCertDuration': '8760h',
          'defaultTLSCertDuration': '8760h',
      }
      with open('/etc/step-ca/config/ca.json', 'w') as f:
          json.dump(cfg, f, indent='\t')
      PYEOF

      # Readable copies for other nodes to fetch (the root cert itself
      # isn't secret — only the CA's private key is, and that never
      # leaves /etc/step-ca/secrets) — confirmed directly: step-ca's own
      # default permissions on root_ca.crt are too restrictive for a
      # remote curl fetch to read.
      chmod 644 /etc/step-ca/certs/root_ca.crt /etc/step-ca/certs/intermediate_ca.crt

  - path: /etc/systemd/system/step-ca.service
    content: |
      [Unit]
      Description=step-ca internal CA
      After=network.target

      [Service]
      Environment=STEPPATH=/etc/step-ca
      ExecStart=/usr/bin/step-ca /etc/step-ca/config/ca.json --password-file /etc/step-ca/password.txt
      Restart=always
      RestartSec=3

      [Install]
      WantedBy=multi-user.target

  # Serves the root+intermediate certs and a tiny health check over
  # plain HTTP on :8080 — every other node's wait-loop and cert-fetch
  # step uses this rather than curl -k'ing the CA's own HTTPS API before
  # it can be trusted, avoiding a chicken-and-egg TLS bootstrap problem.
  - path: /usr/local/sbin/serve-ca-certs.py
    permissions: '0755'
    content: |
      #!/usr/bin/env python3
      import http.server

      class Handler(http.server.SimpleHTTPRequestHandler):
          def __init__(self, *args, **kwargs):
              super().__init__(*args, directory="/etc/step-ca/certs", **kwargs)

      http.server.HTTPServer(("0.0.0.0", 8080), Handler).serve_forever()

  - path: /etc/systemd/system/ca-certs-server.service
    content: |
      [Unit]
      Description=Serve step-ca root/intermediate certs over plain HTTP
      After=network.target

      [Service]
      ExecStart=/usr/bin/python3 /usr/local/sbin/serve-ca-certs.py
      Restart=always

      [Install]
      WantedBy=multi-user.target

runcmd:
  # F-073: promtail's own package postinst auto-starts the
  # service immediately after install, before this runcmd
  # block gets a chance to fix up __HOSTNAME__ or grant the
  # "adm" group — stop it first so the only real start
  # happens against the corrected config, same class of
  # first-boot race already handled for grafana-server by
  # api/setup-logging-service.sh at the host level. Runs FIRST,
  # before any other service on this node starts — found live
  # (F-076, haFullStack-Findings-Log.md) that leaving this until
  # after a tier's own service-setup steps left a real window
  # during which promtail's still-__HOSTNAME__-labeled,
  # postinst-started instance had already started shipping that
  # service's own per-service log file (e.g. proxysql.log) under
  # the wrong host label — journal scraping alone never showed
  # this, only the newer per-service file targets.
  - systemctl stop promtail || true
  - sed "s/__HOSTNAME__/$(hostname)/" -i /etc/promtail/config.yml
  # F-072: promtail's own user isn't a member of "adm" by
  # default, needed to read root:adm 0640
  # /var/log/cloud-init-output.log.
  - usermod -aG adm promtail
  - systemctl enable --now promtail
  - /usr/local/sbin/setup-ca.sh
  - systemctl daemon-reload
  - systemctl enable --now step-ca
  - systemctl enable --now ca-certs-server
