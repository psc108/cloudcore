#cloud-config
# Keystone identity node — genuinely active-active, no per-node role.
# Both nodes run this identical script: keystone-manage db_sync and
# bootstrap are both safe to run unconditionally and concurrently on
# every node (confirmed directly against a real install — re-running
# either against an already-initialized database is a clean no-op, not a
# duplicate/error), so this needs none of MySQL's bootstrap/joiner
# user_data split (haFullStack-LLD.md §3.3.1). The `keystone` apt package
# already ships Apache + mod_wsgi wired up to listen on :5000 out of the
# box (confirmed directly) — no separate systemd unit or reverse-proxy
# config of our own is needed for the daemon itself.
# apt_preserve_sources_list — without this, cloud-init's own apt-
# configure module regenerates /etc/apt/sources.list right after
# bootcmd runs, silently overwriting the NFS-repo rewrite below with
# zero error (confirmed directly). bootcmd (haFullStack-LLD.md §6)
# points apt at the NFS-hosted local repo before the packages: module
# runs; see ca-cloud-init.yaml.tftpl for the full rationale (F-037,
# haFullStack-Findings-Log.md).
apt_preserve_sources_list: true
bootcmd:
  # Scoped to "jammy main" only (nfs-common lives there), not the full
  # default sources.list (main+universe+multiverse+backports+security,
  # ~40MB of index files) — confirmed directly this was still enough to
  # reproduce F-037's mirror congestion across 15 concurrently-booting
  # nodes, even for "just installing one small bootstrap package."
  - |
    echo "deb http://archive.ubuntu.com/ubuntu jammy main" > /etc/apt/sources.list.bootstrap
    apt-get -o Dir::Etc::sourcelist=/etc/apt/sources.list.bootstrap -o Dir::Etc::sourceparts=- -o APT::Get::List-Cleanup=0 update
    apt-get -o Dir::Etc::sourcelist=/etc/apt/sources.list.bootstrap -o Dir::Etc::sourceparts=- -o APT::Get::List-Cleanup=0 install -y --no-install-recommends nfs-common
  - mkdir -p /mnt/apt-repo /mnt/artifacts
  - |
    for i in $(seq 1 60); do
      mount -t nfs ${nfs_ip}:/exports/apt-repo /mnt/apt-repo 2>/dev/null && break
      sleep 5
    done
  - |
    for i in $(seq 1 60); do
      mount -t nfs ${nfs_ip}:/exports/artifacts /mnt/artifacts 2>/dev/null && break
      sleep 5
    done
  - |
    for i in $(seq 1 180); do
      test -f /mnt/apt-repo/.build-complete && test -f /mnt/artifacts/.build-complete && break
      sleep 10
    done
  - mv /etc/apt/sources.list /etc/apt/sources.list.orig-mirror
  - |
    cat > /etc/apt/sources.list <<'EOF'
    deb [trusted=yes] file:///mnt/apt-repo/ ./
    EOF

package_update: true
packages:
  - keystone
  - python3-pymysql
  - python3-memcache
  - mysql-client
  - curl
  - ca-certificates

write_files:
  # Identical Fernet key material on both nodes, generated once in
  # Terraform (main.tf's random_id resources) — writing these directly
  # instead of running `keystone-manage fernet_setup` on each node
  # separately, which would generate two different, incompatible key
  # sets. File format confirmed directly: fernet_setup writes the raw
  # base64url key as the file's entire content, no wrapper — exactly
  # random_id's own .b64_url output.
  #
  # Written to a plain root-owned staging path here, NOT directly to
  # /etc/keystone/fernet-keys/ with owner: keystone:keystone — cloud-init's
  # write_files module runs before the packages stage, so the keystone
  # system user doesn't exist yet at this point (confirmed directly: an
  # owner: on one of these entries made write_files fail outright with
  # "Unknown user or group: keystone", which aborts the WHOLE write_files
  # module, silently skipping every other file in this list too —
  # including setup-keystone.sh below). Moved into place with correct
  # ownership in runcmd instead, which runs after packages are installed.
  - path: /root/fernet-key-0
    permissions: '0600'
    content: ${fernet_key0}
  - path: /root/fernet-key-1
    permissions: '0600'
    content: ${fernet_key1}

  - path: /usr/local/sbin/setup-keystone.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      set -euo pipefail

      mkdir -p /etc/keystone/fernet-keys
      mv /root/fernet-key-0 /etc/keystone/fernet-keys/0
      mv /root/fernet-key-1 /etc/keystone/fernet-keys/1
      chown -R keystone:keystone /etc/keystone/fernet-keys
      chmod 600 /etc/keystone/fernet-keys/0 /etc/keystone/fernet-keys/1

      # Wait for the shared MySQL path (VIP -> NGINX stream{} -> ProxySQL
      # -> MySQL) to actually accept the keystone user's connection before
      # running db_sync — cloud-init on every tier runs concurrently, so
      # NGINX/ProxySQL/MySQL may not be ready yet at this exact moment.
      # Matches this stack's established pattern (see mysql-cloud-init.yaml.tftpl's
      # own wait loop) of an explicit retry rather than relying on
      # Terraform apply order, which doesn't wait for cloud-init to finish
      # on any other node either.
      for i in $(seq 1 60); do
        mysql -h "${vip_address}" -P 3306 -u keystone -p'${keystone_password}' \
          -e "SELECT 1" >/dev/null 2>&1 && break
        sleep 5
      done

      python3 - <<'PYEOF'
      import configparser
      c = configparser.ConfigParser(strict=False)
      c.read('/etc/keystone/keystone.conf')
      c['database']['connection'] = 'mysql+pymysql://keystone:${keystone_password}@${vip_address}:3306/keystone'
      if 'cache' not in c:
          c['cache'] = {}
      c['cache']['enabled'] = 'true'
      c['cache']['backend'] = 'dogpile.cache.memcached'
      c['cache']['memcache_servers'] = '${memcached_servers_csv}'
      with open('/etc/keystone/keystone.conf', 'w') as f:
          c.write(f)
      PYEOF
      chown keystone:keystone /etc/keystone/keystone.conf

      keystone-manage db_sync

      # admin:admin — a deliberate, explicit Lab-only credential (see
      # haFullStack-LLD.md §3.3.1), same convention as vrrp_auth_pass and
      # the MySQL passwords. Endpoint URLs all point at the VIP:5000 —
      # this Lab has no distinct admin/internal network to separate them
      # onto, unlike a real deployment.
      keystone-manage bootstrap \
        --bootstrap-username admin --bootstrap-password admin \
        --bootstrap-project-name admin --bootstrap-role-name admin \
        --bootstrap-service-name keystone \
        --bootstrap-admin-url "http://${vip_address}:5000/v3" \
        --bootstrap-public-url "http://${vip_address}:5000/v3" \
        --bootstrap-internal-url "http://${vip_address}:5000/v3"

  # TLS/mTLS (haFullStack-LLD.md §5.3.1). A NEW port (5443) alongside the
  # existing plain :5000 vhost, which stays as-is for the Lab's own
  # convenience — routed through NGINX's stream{} as a raw TCP
  # passthrough (not http{} + proxy_ssl_*), keeping Keystone consistent
  # with how MySQL/ProxySQL/RabbitMQ's TLS ports are fronted. SSLCACertificateFile
  # is the root+intermediate chain concatenated, not just the root —
  # confirmed necessary the same way RabbitMQ's Erlang SSL stack needed
  # it (see haFullStack-Findings-Log.md); Apache/OpenSSL's own chain
  # verification of the client cert needs the intermediate available
  # locally too, mirroring that finding rather than assuming mod_ssl is
  # exempt from it.
  - path: /usr/local/sbin/setup-keystone-tls.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      set -euo pipefail

      LOCAL_IP=$(hostname -I | awk '{print $1}')

      cp /mnt/artifacts/step-cli.deb /tmp/step-cli.deb
      echo "${step_cli_deb_sha256}  /tmp/step-cli.deb" | sha256sum -c -
      dpkg -i /tmp/step-cli.deb || apt-get install -f -y

      for i in $(seq 1 60); do
        curl -sf "http://${ca_ip}:8080/root_ca.crt" -o /tmp/root_ca.crt \
          && curl -sf "http://${ca_ip}:8080/intermediate_ca.crt" -o /tmp/intermediate_ca.crt \
          && break
        sleep 5
      done

      mkdir -p /etc/keystone/ssl
      step ca certificate "$LOCAL_IP" /etc/keystone/ssl/cert.pem /etc/keystone/ssl/key.pem \
        --san "$LOCAL_IP" --san "${vip_address}" \
        --ca-url "https://${ca_ip}:8443" --root /tmp/root_ca.crt \
        --provisioner admin --provisioner-password-file <(echo -n "${ca_provisioner_password}") \
        --force
      cat /tmp/root_ca.crt /tmp/intermediate_ca.crt > /etc/keystone/ssl/ca.pem
      cp /tmp/root_ca.crt /etc/keystone/ssl/root_ca.pem
      chown -R keystone:keystone /etc/keystone/ssl
      chmod 600 /etc/keystone/ssl/key.pem

      a2enmod ssl

      # Quoted heredoc (<<'EOF') so bash performs no expansion of its own —
      # the doubled-up escapes below are for templatefile()'s own
      # interpolation syntax (this file is rendered by Terraform before
      # cloud-init ever sees it), so Apache's APACHE_LOG_DIR and
      # mod_wsgi's GLOBAL group reach the actual config file intact.
      cat > /etc/apache2/sites-available/keystone-tls.conf <<'EOF'
      Listen 5443

      <VirtualHost *:5443>
        SSLEngine on
        SSLCertificateFile /etc/keystone/ssl/cert.pem
        SSLCertificateKeyFile /etc/keystone/ssl/key.pem
        SSLCACertificateFile /etc/keystone/ssl/ca.pem
        SSLVerifyClient require
        SSLVerifyDepth 2
        SSLProtocol -all +TLSv1.2 +TLSv1.3

        WSGIDaemonProcess keystone-tls processes=3 threads=1 user=keystone group=keystone display-name=keystone-tls
        WSGIProcessGroup keystone-tls
        WSGIScriptAlias / /usr/bin/keystone-wsgi-public
        WSGIApplicationGroup %%{GLOBAL}

        <Directory /usr/bin>
          Require all granted
        </Directory>

        ErrorLog $${APACHE_LOG_DIR}/keystone-tls-error.log
        LogLevel warn
        CustomLog $${APACHE_LOG_DIR}/keystone-tls-access.log combined
      </VirtualHost>
      EOF
      a2ensite keystone-tls

      # Positional <crt> <key> must come immediately after the subcommand,
      # before any flags — confirmed directly: flags-then-positional
      # fails with "too many positional arguments were provided". No
      # `step ca bootstrap` has been run here, so --ca-url/--root are
      # passed explicitly, same as the issuance call above.
      cat > /etc/systemd/system/step-renew.service <<EOF
      [Unit]
      Description=step-ca certificate auto-renewal daemon
      [Service]
      ExecStart=/usr/bin/step ca renew /etc/keystone/ssl/cert.pem /etc/keystone/ssl/key.pem --daemon --force --ca-url "https://${ca_ip}:8443" --root /etc/keystone/ssl/root_ca.pem --exec "systemctl restart apache2"
      Restart=always
      EOF
      systemctl daemon-reload
      systemctl enable --now step-renew

runcmd:
  - /usr/local/sbin/setup-keystone.sh
  - /usr/local/sbin/setup-keystone-tls.sh
  - systemctl restart apache2
