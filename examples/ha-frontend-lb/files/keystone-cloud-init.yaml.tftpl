      - user: fulfillmentSvc
        password: $${password}
        roles:
            - BLOB_STORE_ADMIN
            - BLOB_STORE_USER
            - FULFILLMENT_ADMIN
            - FULFILLMENT_USER
            - CUSTOMERS_SYSTEM_ADMIN
            - CUSTOMERS_ADMIN
            - CUSTOMERS_USER
            - CATALOG_ADMIN
            - CATALOG_USER
            - SERVICE_USER
            - CONFIG_USER
            - CONFIG_ADMIN
            - PRICING_USER
            - PRICING_ADMIN
            - ACL_ADMIN
            - REQUEST_ADMIN
            - REQUEST_NOTIFICATION_SENDER
