      - user: testsystemadmin
        password: $${password}
        roles:
            - BUSINESS_SYSTEM_ADMIN

  # No WSGIDaemonProcess/service pool involved here — this is a one-shot
  # API client, not a listener, so none of F-051's memory concerns apply.
  # Runs against Keystone's own local :5000 (plain HTTP, no CA needed —
  # requests' verify= parameter is only consulted for https:// URLs;
  # /etc/keystone/ssl/root_ca.pem is passed anyway since it already
  # exists by this point in the boot sequence, real value not a dummy).
  # Retries each import a few times: both Keystone nodes run this same
  # script concurrently, and import_p3.py's own "does this already
  # exist" check has a real (if narrow) race window between the two
  # nodes — a retry after a losing 409 just re-checks state and finds
  # the object the other node already created.
  - path: /usr/local/sbin/setup-keystone-roles.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      set -euo pipefail
      cd /usr/local/lib/keystone-import

      for i in $(seq 1 60); do
        curl -sf http://127.0.0.1:5000/v3 >/dev/null 2>&1 && break
        sleep 5
      done

      export OS_AUTH_URL=http://127.0.0.1:5000/v3
      export OS_USERNAME=admin
      export OS_PASSWORD=admin

      roles_ok=false
      for i in 1 2 3; do
        python3 import_p3.py -i roles.yml -k "$OS_AUTH_URL" -u "$OS_USERNAME" \
          -p "$OS_PASSWORD" -c /etc/keystone/ssl/root_ca.pem && { roles_ok=true; break; }
        sleep 10
      done
      $roles_ok || echo "setup-keystone-roles.sh: roles.yml import did not complete after 3 attempts" >&2

      domain_ok=false
      for i in 1 2 3; do
        python3 import_p3.py -i system_domain.yml -k "$OS_AUTH_URL" -u "$OS_USERNAME" \
          -p "$OS_PASSWORD" -c /etc/keystone/ssl/root_ca.pem \
          -e password,${keystone_system_domain_password} && { domain_ok=true; break; }
        sleep 10
      done
      $domain_ok || echo "setup-keystone-roles.sh: system_domain.yml import did not complete after 3 attempts" >&2

      $roles_ok && $domain_ok

  - path: /usr/local/sbin/setup-keystone.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      set -euo pipefail

      mkdir -p /etc/keystone/fernet-keys
      mv /root/fernet-key-0 /etc/keystone/fernet-keys/0
      mv /root/fernet-key-1 /etc/keystone/fernet-keys/1
      chown -R keystone:keystone /etc/keystone/fernet-keys
      chmod 600 /etc/keystone/fernet-keys/0 /etc/keystone/fernet-keys/1

      mv /root/keystone-policy.json /etc/keystone/policy.json
      chown keystone:keystone /etc/keystone/policy.json
      chmod 644 /etc/keystone/policy.json

      # Wait for the shared MySQL path (VIP -> NGINX stream{} -> ProxySQL
      # -> MySQL) to actually accept the keystone user's connection before
      # running db_sync — cloud-init on every tier runs concurrently, so
      # NGINX/ProxySQL/MySQL may not be ready yet at this exact moment.
      # Matches this stack's established pattern (see mysql-cloud-init.yaml.tftpl's
      # own wait loop) of an explicit retry rather than relying on
      # Terraform apply order, which doesn't wait for cloud-init to finish
      # on any other node either.
      for i in $(seq 1 180); do
        mysql -h "${vip_address}" -P 3306 -u keystone -p'${keystone_password}' \
          -e "SELECT 1" >/dev/null 2>&1 && break
        sleep 5
      done

      python3 - <<'PYEOF'
      import configparser
      c = configparser.ConfigParser(strict=False)
      c.read('/etc/keystone/keystone.conf')
      c['database']['connection'] = 'mysql+pymysql://keystone:${keystone_password}@${vip_address}:3306/keystone'
      if 'cache' not in c:
          c['cache'] = {}
      c['cache']['enabled'] = 'true'
      c['cache']['backend'] = 'dogpile.cache.memcached'
      c['cache']['memcache_servers'] = '${memcached_servers_csv}'
      with open('/etc/keystone/keystone.conf', 'w') as f:
          c.write(f)
      PYEOF
      chown keystone:keystone /etc/keystone/keystone.conf

      keystone-manage db_sync

      # admin:admin — a deliberate, explicit Lab-only credential (see
      # haFullStack-LLD.md §3.3.1), same convention as vrrp_auth_pass and
      # the MySQL passwords. Public/internal stay on the VIP:5000 vhost
      # the keystone package ships out of the box; admin uses the classic
      # OpenStack :35357 convention instead (setup-keystone-admin-port.sh
      # below adds that listener) — this Lab has no distinct admin/
      # internal network to separate them onto otherwise.
      keystone-manage bootstrap \
        --bootstrap-username admin --bootstrap-password admin \
        --bootstrap-project-name admin --bootstrap-role-name admin \
        --bootstrap-service-name keystone \
        --bootstrap-admin-url "http://${vip_address}:35357/v3" \
        --bootstrap-public-url "http://${vip_address}:5000/v3" \
        --bootstrap-internal-url "http://${vip_address}:5000/v3"

  # Classic OpenStack admin-API port (35357), alongside the package's own
  # :5000 vhost — same unified keystone-wsgi-public WSGI app as :5000 and
  # the :5443 mTLS vhost below (modern Keystone has no separate admin WSGI
  # script), so this is just a second plain-HTTP listener, not a
  # functionally different API. Routed to clients through the shared
  # VIP's NGINX (nginx-keystone.conf.tftpl), same as :5000.
  - path: /usr/local/sbin/setup-keystone-admin-port.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      set -euo pipefail

      # No WSGIDaemonProcess of its own — reuses the :5000 vhost's existing
      # "keystone-public" pool (processes=5, from the keystone package's
      # own wsgi-keystone.conf) by name instead of spawning a new one.
      # A first attempt gave this port its own 3-process pool, on top of
      # :5000's 5 and :5443's 3 — 11 mod_wsgi worker processes total OOM-
      # killed apache2 outright on this tier's standard.small flavor
      # (957MB RAM), confirmed directly (systemctl status showed "Result:
      # oom-kill", found chasing what looked like a security-group/DNS
      # connectivity failure but was neither). Sharing the pool costs zero
      # extra memory — it's the same already-running workers now also
      # bound to a second port.
      cat > /etc/apache2/sites-available/keystone-admin.conf <<'EOF'
      Listen 35357

      <VirtualHost *:35357>
        WSGIProcessGroup keystone-public
        WSGIScriptAlias / /usr/bin/keystone-wsgi-public
        WSGIApplicationGroup %%{GLOBAL}

        <Directory /usr/bin>
          Require all granted
        </Directory>

        ErrorLog $${APACHE_LOG_DIR}/keystone-admin-error.log
        LogLevel warn
        CustomLog $${APACHE_LOG_DIR}/keystone-admin-access.log combined
      </VirtualHost>
      EOF
      a2ensite keystone-admin

  # env.sh — OpenStack CLI client environment, sourced by root/ecs/ubuntu
  # (runcmd below symlinks it into each user's home directory). Lives
  # under /etc/openstack/, NOT /etc/keystone/ — the latter is
  # keystone:keystone 0750 (package default), so non-keystone-group users
  # like ecs can't even traverse into it to reach a 0644 file inside,
  # confirmed directly ("Permission denied" sourcing the symlink as ecs).
  # OS_AUTH_URL points at the VIP's :35357 admin listener, not any one
  # keystone node's own IP — the VIP is already a static value known at
  # Terraform-render time (var.vip_address), so no runtime IP-discovery
  # step (e.g. a systemd oneshot) is needed here; a fixed per-node IP
  # would also break this file on failover, defeating the point of the HA
  # VIP. admin:admin matches the bootstrap credential above — this Lab's
  # deliberate, documented placeholder, not a new secret. No OS_CACERT/
  # https — :35357 is plain HTTP like :5000, not the separate :5443 mTLS
  # listener, which needs a client cert+key to authenticate, not just a
  # CA cert.
  - path: /etc/openstack/env.sh
    permissions: '0644'
    content: |
      export OS_USERNAME=admin
      export OS_PASSWORD='admin'
      export OS_PROJECT_NAME=admin
      export OS_USER_DOMAIN_NAME=Default
      export OS_PROJECT_DOMAIN_NAME=Default
      export OS_AUTH_URL=http://${vip_address}:35357/v3
      export OS_IDENTITY_API_VERSION=3
      export no_proxy=${vip_address}

  # TLS/mTLS (haFullStack-LLD.md §5.3.1). A NEW port (5443) alongside the
  # existing plain :5000 vhost, which stays as-is for the Lab's own
  # convenience — routed through NGINX's stream{} as a raw TCP
  # passthrough (not http{} + proxy_ssl_*), keeping Keystone consistent
  # with how MySQL/ProxySQL/RabbitMQ's TLS ports are fronted. SSLCACertificateFile
  # is the root+intermediate chain concatenated, not just the root —
  # confirmed necessary the same way RabbitMQ's Erlang SSL stack needed
  # it (see haFullStack-Findings-Log.md); Apache/OpenSSL's own chain
  # verification of the client cert needs the intermediate available
  # locally too, mirroring that finding rather than assuming mod_ssl is
  # exempt from it.
  - path: /usr/local/sbin/setup-keystone-tls.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      set -euo pipefail

      LOCAL_IP=$(hostname -I | awk '{print $1}')

      curl -fsSL http://192.168.100.1:8090/jammy/artifacts/step-cli.deb -o /tmp/step-cli.deb
      echo "${step_cli_deb_sha256}  /tmp/step-cli.deb" | sha256sum -c -
      dpkg -i /tmp/step-cli.deb || apt-get install -f -y

      for i in $(seq 1 180); do
        curl -sf "http://${ca_ip}:8080/root_ca.crt" -o /tmp/root_ca.crt \
          && curl -sf "http://${ca_ip}:8080/intermediate_ca.crt" -o /tmp/intermediate_ca.crt \
          && break
        sleep 5
      done

      mkdir -p /etc/keystone/ssl
      step ca certificate "$LOCAL_IP" /etc/keystone/ssl/cert.pem /etc/keystone/ssl/key.pem \
        --san "$LOCAL_IP" --san "${vip_address}" \
        --ca-url "https://${ca_ip}:8443" --root /tmp/root_ca.crt \
        --provisioner admin --provisioner-password-file <(echo -n "${ca_provisioner_password}") \
        --force
      cat /tmp/root_ca.crt /tmp/intermediate_ca.crt > /etc/keystone/ssl/ca.pem
      cp /tmp/root_ca.crt /etc/keystone/ssl/root_ca.pem
      chown -R keystone:keystone /etc/keystone/ssl
      chmod 600 /etc/keystone/ssl/key.pem

      a2enmod ssl

      # Quoted heredoc (<<'EOF') so bash performs no expansion of its own —
      # the doubled-up escapes below are for templatefile()'s own
      # interpolation syntax (this file is rendered by Terraform before
      # cloud-init ever sees it), so Apache's APACHE_LOG_DIR and
      # mod_wsgi's GLOBAL group reach the actual config file intact.
      cat > /etc/apache2/sites-available/keystone-tls.conf <<'EOF'
      Listen 5443

      <VirtualHost *:5443>
        SSLEngine on
        SSLCertificateFile /etc/keystone/ssl/cert.pem
        SSLCertificateKeyFile /etc/keystone/ssl/key.pem
        SSLCACertificateFile /etc/keystone/ssl/ca.pem
        SSLVerifyClient require
        SSLVerifyDepth 2
        SSLProtocol -all +TLSv1.2 +TLSv1.3

        WSGIDaemonProcess keystone-tls processes=3 threads=1 user=keystone group=keystone display-name=keystone-tls
        WSGIProcessGroup keystone-tls
        WSGIScriptAlias / /usr/bin/keystone-wsgi-public
        WSGIApplicationGroup %%{GLOBAL}

        <Directory /usr/bin>
          Require all granted
        </Directory>

        ErrorLog $${APACHE_LOG_DIR}/keystone-tls-error.log
        LogLevel warn
        CustomLog $${APACHE_LOG_DIR}/keystone-tls-access.log combined
      </VirtualHost>
      EOF
      a2ensite keystone-tls

      # Positional <crt> <key> must come immediately after the subcommand,
      # before any flags — confirmed directly: flags-then-positional
      # fails with "too many positional arguments were provided". No
      # `step ca bootstrap` has been run here, so --ca-url/--root are
      # passed explicitly, same as the issuance call above.
      cat > /etc/systemd/system/step-renew.service <<EOF
      [Unit]
      Description=step-ca certificate auto-renewal daemon
      [Service]
      ExecStart=/usr/bin/step ca renew /etc/keystone/ssl/cert.pem /etc/keystone/ssl/key.pem --daemon --force --ca-url "https://${ca_ip}:8443" --root /etc/keystone/ssl/root_ca.pem --exec "systemctl restart apache2"
      Restart=always
      EOF
      systemctl daemon-reload
      systemctl enable --now step-renew

runcmd:
  - /usr/local/sbin/setup-keystone.sh
  - /usr/local/sbin/setup-keystone-tls.sh
  - /usr/local/sbin/setup-keystone-roles.sh
  - /usr/local/sbin/setup-keystone-admin-port.sh
  - systemctl restart apache2
  - |
    for u in root ecs ubuntu; do
      home=$(getent passwd "$u" | cut -d: -f6)
      [ -d "$home" ] || continue
      ln -sf /etc/openstack/env.sh "$home/env.sh"
    done
