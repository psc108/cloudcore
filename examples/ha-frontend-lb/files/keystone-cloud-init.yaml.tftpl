          "identity:get_user": "rule:cpi_admins_or_admin_or_owner",
          "identity:list_users": "rule:cpi_admins_or_admin_or_impersonator",
          "identity:create_user": "rule:cpi_admin_or_admin",
          "identity:update_user": "rule:cpi_admin_or_admin",
          "identity:delete_user": "rule:admin_required",
          "identity:change_password": "rule:admin_or_owner",

          "identity:get_group": "rule:cpi_service_user_role_or_admin",
          "identity:list_groups": "rule:admin_required",
          "identity:list_groups_for_user": "rule:cpi_impersonator_or_admin_or_owner",
          "identity:create_group": "rule:admin_required",
          "identity:update_group": "rule:admin_required",
          "identity:delete_group": "rule:admin_required",
          "identity:list_users_in_group": "rule:admin_required",
          "identity:remove_user_from_group": "rule:admin_required",
          "identity:check_user_in_group": "rule:admin_required",
          "identity:add_user_to_group": "rule:admin_required",

          "identity:get_credential": "rule:admin_required",
