  # $${password} below is import_p3.py's OWN template placeholder
  # (its ExtendedTemplate.safe_substitute(), substituted at runtime via
  # setup-keystone-roles.sh's -e password,... argument) — escaped here
  # so Terraform's templatefile() passes it through literally instead of
  # trying to resolve it as one of its own interpolations.
  - path: /usr/local/lib/keystone-import/system_domain.yml
    permissions: '0644'
    content: |
      ---
      - domain: system
        description: Domain for system administrators and service accounts
      - user: admin
        password: $${password}
        roles:
            - BUSINESS_ADMIN
      - user: intadmin
        password: $${password}
