#cloud-config
# One-shot apt-repo + pinned-artifact cache builder (haFullStack-LLD.md
# §6). Not a permanent tier — created only when var.build_repo_now is
# true, torn down on a later apply once the NFS shares are confirmed
# populated. Mounts the same two NFS exports every other tier's own
# cloud-init will later mount read-only, and populates them:
#   apt-repo/   — a real, dpkg-scanpackages-indexed local apt repo
#                 covering every package this stack's tiers install,
#                 flat-repo format (no dists/ hierarchy — the simplest
#                 valid layout for a small custom repo)
#   artifacts/  — the pinned step-ca/step-cli/proxysql .debs, fetched
#                 once here instead of by every consuming node
#                 individually (12+ redundant downloads today, F-037)
package_update: true
packages:
  - curl
  - ca-certificates
  - nfs-common
  - dpkg-dev

write_files:
  - path: /usr/local/sbin/build-repo.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      set -euo pipefail

      mkdir -p /mnt/apt-repo /mnt/artifacts
      for i in $(seq 1 30); do
        mount -t nfs ${nfs_ip}:/exports/apt-repo /mnt/apt-repo && break
        sleep 5
      done
      for i in $(seq 1 30); do
        mount -t nfs ${nfs_ip}:/exports/artifacts /mnt/artifacts && break
        sleep 5
      done

      # Full closure, not just the top-level names — apt resolves every
      # transitive dependency against the real mirror here, same as it
      # would on any consuming node; --reinstall forces a real download
      # even for anything already present on this base image, so the
      # repo genuinely stands alone rather than silently depending on
      # base-image contents matching every consuming node's own image.
      apt-get install --download-only --reinstall -y ${repo_packages_csv}

      cp /var/cache/apt/archives/*.deb /mnt/apt-repo/
      cd /mnt/apt-repo
      dpkg-scanpackages . /dev/null > Packages
      gzip -9fc Packages > Packages.gz

      cat > /mnt/apt-repo/MANIFEST.txt <<EOF
      Built: $(date -u +%Y-%m-%dT%H:%M:%SZ)
      Ubuntu release: $(lsb_release -cs)
      Source packages requested: ${repo_packages_csv}
      Package count (including transitive deps): $(ls /mnt/apt-repo/*.deb | wc -l)
      EOF

      for i in $(seq 1 5); do
        curl -fL -o /tmp/step-ca.deb "${step_ca_deb_url}" && break
        sleep 5
      done
      echo "${step_ca_deb_sha256}  /tmp/step-ca.deb" | sha256sum -c -

      for i in $(seq 1 5); do
        curl -fL -o /tmp/step-cli.deb "${step_cli_deb_url}" && break
        sleep 5
      done
      echo "${step_cli_deb_sha256}  /tmp/step-cli.deb" | sha256sum -c -

      for i in $(seq 1 5); do
        curl -fL --speed-limit 1024 --speed-time 30 -C - \
          -o /tmp/proxysql.deb "${proxysql_deb_url}" && break
        sleep 5
      done
      echo "${proxysql_deb_sha256}  /tmp/proxysql.deb" | sha256sum -c -

      cp /tmp/step-ca.deb /tmp/step-cli.deb /tmp/proxysql.deb /mnt/artifacts/
      cat > /mnt/artifacts/MANIFEST.txt <<EOF
      Built: $(date -u +%Y-%m-%dT%H:%M:%SZ)
      step-ca.deb    sha256=${step_ca_deb_sha256}    source=${step_ca_deb_url}
      step-cli.deb   sha256=${step_cli_deb_sha256}   source=${step_cli_deb_url}
      proxysql.deb   sha256=${proxysql_deb_sha256}   source=${proxysql_deb_url}
      EOF

      touch /mnt/apt-repo/.build-complete
      touch /mnt/artifacts/.build-complete

runcmd:
  - /usr/local/sbin/build-repo.sh
