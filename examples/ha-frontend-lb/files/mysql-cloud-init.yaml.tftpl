#cloud-config
# MySQL Group Replication node. server_id / bootstrap-vs-join behaviour is
# this node's own identity, baked in from Terraform; its own IP and the
# interface name are detected at runtime (bridged instances only know
# these after boot), same pattern as NGINX's Keepalived interface
# detection in nginx-cloud-init.yaml.tftpl.
#
# Only the bootstrap node's own IP is known to the two joiner nodes at
# apply time (modules/compute's per-key user_data can't reference that
# same module call's own IP outputs — see haFullStack-LLD.md §2.3.2/§2.7)
# — joiners seed off the bootstrap node alone. Group Replication's own
# gossip protocol discovers full membership once joined; this is a known
# simplification (not a full mesh seed list), flagged in haFullStack-LLD.md
# §2.7.
# apt_preserve_sources_list — without this, cloud-init's own apt-
# configure module regenerates /etc/apt/sources.list from its own
# default-mirror template right after bootcmd runs, silently
# overwriting the NFS-repo rewrite below with zero error (confirmed
# directly). bootcmd (haFullStack-LLD.md §6) points apt at the
# NFS-hosted local repo before the packages: module runs, instead of
# hitting the real Ubuntu mirror; see ca-cloud-init.yaml.tftpl for the
# full rationale (F-037, haFullStack-Findings-Log.md).
apt_preserve_sources_list: true
bootcmd:
  # Scoped to "jammy main" only (nfs-common lives there), not the full
  # default sources.list (main+universe+multiverse+backports+security,
  # ~40MB of index files) — confirmed directly this was still enough to
  # reproduce F-037's mirror congestion across 15 concurrently-booting
  # nodes, even for "just installing one small bootstrap package."
  - |
    echo "deb http://archive.ubuntu.com/ubuntu jammy main" > /etc/apt/sources.list.bootstrap
    apt-get -o Dir::Etc::sourcelist=/etc/apt/sources.list.bootstrap -o Dir::Etc::sourceparts=- -o APT::Get::List-Cleanup=0 update
    apt-get -o Dir::Etc::sourcelist=/etc/apt/sources.list.bootstrap -o Dir::Etc::sourceparts=- -o APT::Get::List-Cleanup=0 install -y --no-install-recommends nfs-common
  - mkdir -p /mnt/apt-repo /mnt/artifacts
  - |
    for i in $(seq 1 60); do
      mount -t nfs ${nfs_ip}:/exports/apt-repo /mnt/apt-repo 2>/dev/null && break
      sleep 5
    done
  - |
    for i in $(seq 1 60); do
      mount -t nfs ${nfs_ip}:/exports/artifacts /mnt/artifacts 2>/dev/null && break
      sleep 5
    done
  - |
    for i in $(seq 1 180); do
      test -f /mnt/apt-repo/.build-complete && test -f /mnt/artifacts/.build-complete && break
      sleep 10
    done
  - mv /etc/apt/sources.list /etc/apt/sources.list.orig-mirror
  - |
    cat > /etc/apt/sources.list <<'EOF'
    deb [trusted=yes] file:///mnt/apt-repo/ ./
    EOF

package_update: true
packages:
  - mysql-server
  - curl

write_files:
  # TLS/mTLS (haFullStack-LLD.md §5.3.1) — this node's own server cert
  # from the CA, and REQUIRE X509 on client-facing accounts. Deliberately
  # NOT applied to the 'repl' user / recovery channel — Group
  # Replication's own recovery-channel TLS is a separate mechanism
  # (group_replication_recovery_use_ssl), out of scope for this slice.
  # SAN includes both this node's own IP (direct connections, e.g. this
  # script's own verification) and the VIP (the path real clients — via
  # ProxySQL — actually use for VERIFY_IDENTITY-strict verification).
  #
  # Split into two scripts and run either side of setup-group-replication.sh
  # (see runcmd below), not one script after it — confirmed directly:
  # running this file's own `systemctl restart mysql` AFTER Group
  # Replication has already started kills the mysqld process GR is
  # running in, and nothing re-issues START GROUP_REPLICATION afterward,
  # leaving every node permanently OFFLINE. The cert/TLS-config half (this
  # script) has to land BEFORE mysqld is asked to start group_replication
  # at all, so the one restart it needs happens on a not-yet-clustered
  # server; the REQUIRE X509 half (setup-mysql-tls-accounts.sh below) has
  # to land AFTER, since it needs accounts setup-group-replication.sh's
  # bootstrap block creates — and it does no restart of its own, so it's
  # safe to run post-GR.
  - path: /usr/local/sbin/setup-mysql-tls-certs.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      set -euo pipefail

      LOCAL_IP=$(hostname -I | awk '{print $1}')

      cp /mnt/artifacts/step-cli.deb /tmp/step-cli.deb
      echo "${step_cli_deb_sha256}  /tmp/step-cli.deb" | sha256sum -c -
      dpkg -i /tmp/step-cli.deb || apt-get install -f -y

      for i in $(seq 1 60); do
        curl -sf "http://${ca_ip}:8080/root_ca.crt" -o /tmp/root_ca.crt \
          && curl -sf "http://${ca_ip}:8080/intermediate_ca.crt" -o /tmp/intermediate_ca.crt \
          && break
        sleep 5
      done

      mkdir -p /etc/mysql/ssl
      step ca certificate "$LOCAL_IP" /etc/mysql/ssl/server-cert.pem /etc/mysql/ssl/server-key.pem \
        --san "$LOCAL_IP" --san "${vip_address}" \
        --ca-url "https://${ca_ip}:8443" --root /tmp/root_ca.crt \
        --provisioner admin --provisioner-password-file <(echo -n "${ca_provisioner_password}") \
        --force
      cp /tmp/root_ca.crt /etc/mysql/ssl/ca.crt
      # Dedicated, persisted copy for step-renew's own --root below —
      # /tmp isn't guaranteed to survive this cert's ~24h validity
      # window, unlike the running service's own config directory.
      cp /tmp/root_ca.crt /etc/mysql/ssl/root_ca.crt
      chown -R mysql:mysql /etc/mysql/ssl
      chmod 600 /etc/mysql/ssl/server-key.pem

      # Deliberately NOT setting require_secure_transport=ON here —
      # confirmed directly: it's a transport-level gate applied before
      # authentication even begins, rejecting every plaintext TCP
      # connection regardless of account. That includes Group
      # Replication's own internal recovery channel (the 'repl' user),
      # which is deliberately plaintext (out of scope, see comment
      # above) — with the flag ON, a joiner's very first donor connection
      # is refused with "Connections using insecure transport are
      # prohibited" (MY-003159), the node exhausts its recovery retries,
      # and self-evicts ("This member has left the group"). Per-account
      # REQUIRE X509 below (and on keystone/proxysql_monitor) already
      # enforces TLS for the client-facing accounts entirely independently
      # of this global flag, so client-facing mTLS is unaffected by
      # leaving it off.
      cat > /etc/mysql/mysql.conf.d/zz-tls.cnf <<EOF
      [mysqld]
      ssl-ca   = /etc/mysql/ssl/ca.crt
      ssl-cert = /etc/mysql/ssl/server-cert.pem
      ssl-key  = /etc/mysql/ssl/server-key.pem
      EOF
      systemctl restart mysql

      # step ca renew's positional <crt-file> <key-file> args must come
      # immediately after the subcommand, before any flags — confirmed
      # directly: `step ca renew --daemon --force <crt> <key> --exec ...`
      # fails with "too many positional arguments were provided". No
      # `step ca bootstrap` has been run on this node (its $STEPPATH has
      # no CA trust config), so --ca-url/--root have to be passed
      # explicitly here too, same as the issuance call above. The --exec
      # hook uses ALTER INSTANCE RELOAD TLS, not a restart — reloads the
      # renewed cert/key files mysqld already has paths to configured,
      # without tearing down this node's Group Replication membership the
      # way a second `systemctl restart mysql` would.
      cat > /etc/systemd/system/step-renew.service <<EOF
      [Unit]
      Description=step-ca certificate auto-renewal daemon
      [Service]
      ExecStart=/usr/bin/step ca renew /etc/mysql/ssl/server-cert.pem /etc/mysql/ssl/server-key.pem --daemon --force --ca-url "https://${ca_ip}:8443" --root /etc/mysql/ssl/root_ca.crt --exec "mysql -u root -e 'ALTER INSTANCE RELOAD TLS;'"
      Restart=always
      EOF
      systemctl daemon-reload
      systemctl enable --now step-renew

  - path: /usr/local/sbin/setup-mysql-tls-accounts.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      set -euo pipefail

      %{ if is_bootstrap ~}
      # Client-facing accounts only — the recovery channel above is
      # deliberately untouched (out of scope, see comment above). Runs
      # after setup-group-replication.sh, once these accounts actually
      # exist (created in its bootstrap block) — no mysqld restart here,
      # so it's safe to run post-GR.
      mysql -u root <<SQL
      ALTER USER 'appuser'@'%' REQUIRE X509;
      ALTER USER 'keystone'@'%' REQUIRE X509;
      ALTER USER 'proxysql_monitor'@'%' REQUIRE X509;
      SQL
      %{ endif ~}


  - path: /usr/local/sbin/setup-group-replication.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      set -euo pipefail

      LOCAL_IP=$(hostname -I | awk '{print $1}')

      # Named to sort after Ubuntu's own mysqld.cnf (alphabetically, in
      # /etc/mysql/mysql.conf.d/*.cnf's load order) — mysqld.cnf ships
      # with "bind-address = 127.0.0.1" and, loaded later, would
      # otherwise silently override this file's "0.0.0.0" (found
      # empirically: mysqld was listening on 127.0.0.1:3306 only, despite
      # this file explicitly setting 0.0.0.0, blocking every other node's
      # connection with a bare "Connection refused").
      cat > /etc/mysql/mysql.conf.d/zz-group-replication.cnf <<EOF
      [mysqld]
      bind-address = 0.0.0.0
      # Without this, other members refer to and connect to this node by
      # its OS hostname (e.g. "example-dev-mysql-a") — which none of
      # these guests can resolve (no /etc/hosts entries, no reachable
      # DNS from inside a guest) — breaking distributed recovery with
      # "Unknown MySQL server host" the moment a joiner tries to connect
      # to its donor. report_host makes every member (including this
      # one, for when it's the donor) report and connect via a real IP
      # instead.
      report_host = "$LOCAL_IP"
      server-id = ${server_id}
      gtid_mode = ON
      enforce_gtid_consistency = ON
      binlog_format = ROW
      log_bin = mysql-bin
      log_slave_updates = ON

      # group_replication_* below are plugin-defined variables, not core
      # server variables — mysqld rejects them as "unknown variable" and
      # refuses to start unless the plugin is already loaded. INSTALL
      # PLUGIN can't run before mysqld has successfully started, so on a
      # fresh install this needs plugin_load_add (loads it directly from
      # the .so file at startup) rather than relying on INSTALL PLUGIN's
      # normal "register for future restarts" behaviour.
      plugin_load_add = group_replication.so
      group_replication_group_name = "${group_name}"
      group_replication_start_on_boot = OFF
      group_replication_local_address = "$LOCAL_IP:33061"
      group_replication_group_seeds = "${group_seeds}"
      group_replication_single_primary_mode = ON
      group_replication_enforce_update_everywhere_checks = OFF
      group_replication_autorejoin_tries = 3
      EOF

      systemctl restart mysql

      # The recovery channel needs this account to exist locally on every
      # node (bootstrap or joiner) before that node starts group
      # replication — every node runs this identical block, so donor and
      # joiner always agree on the credential. SET SQL_LOG_BIN=0 keeps its
      # creation out of the binlog Group Replication itself replicates.
      mysql -u root <<SQL
      SET SQL_LOG_BIN=0;
      # mysql_native_password, not the 8.0 default caching_sha2_password:
      # the recovery channel connection between nodes isn't over TLS here
      # (no cert distribution set up for this Lab prototype), and
      # caching_sha2_password refuses to authenticate at all without a
      # secure connection ("Authentication requires secure connection",
      # found empirically) — the standard simplification for a non-TLS
      # lab setup, not appropriate for a production deployment.
      CREATE USER IF NOT EXISTS 'repl'@'%' IDENTIFIED WITH mysql_native_password BY '${repl_password}';
      GRANT REPLICATION SLAVE ON *.* TO 'repl'@'%';
      GRANT BACKUP_ADMIN ON *.* TO 'repl'@'%';
      GRANT SELECT ON performance_schema.* TO 'repl'@'%';
      SET SQL_LOG_BIN=1;
      CHANGE REPLICATION SOURCE TO SOURCE_USER='repl', SOURCE_PASSWORD='${repl_password}' FOR CHANNEL 'group_replication_recovery';
      SQL

      %{ if is_bootstrap ~}
      mysql -u root <<SQL
      SET GLOBAL group_replication_bootstrap_group = ON;
      START GROUP_REPLICATION;
      SET GLOBAL group_replication_bootstrap_group = OFF;

      # mysql_native_password: ProxySQL has historically had limited
      # caching_sha2_password support for its own backend connections,
      # and this environment has no TLS set up between nodes anyway —
      # same reasoning as the repl user above.
      CREATE USER IF NOT EXISTS 'proxysql_monitor'@'%' IDENTIFIED WITH mysql_native_password BY '${monitor_password}';
      GRANT REPLICATION CLIENT ON *.* TO 'proxysql_monitor'@'%';
      GRANT SELECT ON performance_schema.* TO 'proxysql_monitor'@'%';
      CREATE USER IF NOT EXISTS 'appuser'@'%' IDENTIFIED WITH mysql_native_password BY '${app_password}';
      GRANT SELECT ON performance_schema.* TO 'appuser'@'%';

      CREATE DATABASE IF NOT EXISTS clusterdemo;
      GRANT ALL PRIVILEGES ON clusterdemo.* TO 'appuser'@'%';
      CREATE TABLE IF NOT EXISTS clusterdemo.heartbeat (
          id INT PRIMARY KEY,
          counter BIGINT NOT NULL DEFAULT 0,
          updated_at DATETIME NOT NULL
      );
      INSERT INTO clusterdemo.heartbeat (id, counter, updated_at) VALUES (1, 0, NOW())
        ON DUPLICATE KEY UPDATE updated_at = NOW();

      -- Keystone's own database + dedicated user (own credentials, not
      -- shared with appuser) — haFullStack-LLD.md §3.3.1. Same
      -- mysql_native_password reasoning as every other user here: no TLS
      -- set up between nodes in this Lab, and ProxySQL/8.0's default
      -- caching_sha2_password needs a secure connection to authenticate
      -- at all (F-019).
      CREATE USER IF NOT EXISTS 'keystone'@'%' IDENTIFIED WITH mysql_native_password BY '${keystone_password}';
      CREATE DATABASE IF NOT EXISTS keystone;
      GRANT ALL PRIVILEGES ON keystone.* TO 'keystone'@'%';
      SQL
      %{ else ~}
      # Wait for the bootstrap node's group to actually be ONLINE before
      # attempting to join — cloud-init on all 3 nodes runs concurrently,
      # so the bootstrap node's own SQL sequence above may not have
      # finished yet (haFullStack-LLD.md §2.3.1's flagged risk).
      SEED_HOST=$(echo "${group_seeds}" | cut -d: -f1)
      for i in $(seq 1 60); do
        if mysql -h "$SEED_HOST" -u repl -p'${repl_password}' -N -e \
             "SELECT MEMBER_STATE FROM performance_schema.replication_group_members WHERE MEMBER_STATE='ONLINE'" \
             2>/dev/null | grep -q ONLINE; then
          break
        fi
        sleep 5
      done

      mysql -u root -e "START GROUP_REPLICATION;"
      %{ endif ~}

  # Group Replication does not refuse writes below the ORIGINAL cluster's
  # majority by default — it expels unreachable peers and continues as a
  # legitimate, smaller group (haFullStack-Findings-Log.md F-021,
  # haFullStack.md §5.3). This runs locally on every node (root via the
  # Unix socket — no new remote-accessible privileged account) and
  # enforces read-only if this node is PRIMARY of a group that's shrunk
  # below majority, clearing it again once original membership returns.
  # super_read_only=OFF does NOT auto-clear the separate read_only flag —
  # both have to be cleared, in that order, or ProxySQL's own GR monitor
  # never re-adds the node to the writer hostgroup (found empirically).
  - path: /usr/local/sbin/quorum-watchdog.py
    permissions: '0755'
    content: |
      #!/usr/bin/env python3
      import subprocess

      EXPECTED_MEMBERS = 3
      MAJORITY = EXPECTED_MEMBERS // 2 + 1


      def run_sql(sql):
          cmd = ["mysql", "-u", "root", "-N", "-B", "-e", sql]
          try:
              r = subprocess.run(cmd, capture_output=True, text=True, timeout=5)
          except Exception:
              return None
          if r.returncode != 0:
              return None
          return r.stdout


      def main():
          out = run_sql(
              "SELECT MEMBER_STATE, MEMBER_ROLE FROM "
              "performance_schema.replication_group_members "
              "WHERE MEMBER_ID = @@server_uuid;"
          )
          if not out:
              return
          parts = out.strip().split("\t")
          if len(parts) != 2:
              return
          my_state, my_role = parts
          if my_state != "ONLINE" or my_role != "PRIMARY":
              return

          out = run_sql(
              "SELECT COUNT(*) FROM performance_schema.replication_group_members "
              "WHERE MEMBER_STATE='ONLINE';"
          )
          online_count = int(out.strip()) if out and out.strip().isdigit() else 0

          if online_count < MAJORITY:
              run_sql("SET GLOBAL super_read_only = ON;")
          else:
              run_sql("SET GLOBAL super_read_only = OFF;")
              run_sql("SET GLOBAL read_only = OFF;")


      if __name__ == "__main__":
          main()

  - path: /etc/systemd/system/quorum-watchdog.service
    content: |
      [Unit]
      Description=Enforce read-only below cluster majority

      [Service]
      Type=oneshot
      ExecStart=/usr/local/sbin/quorum-watchdog.py

  - path: /etc/systemd/system/quorum-watchdog.timer
    content: |
      [Unit]
      Description=Run quorum-watchdog.service every 3s

      [Timer]
      OnBootSec=10s
      OnUnitActiveSec=3s

      [Install]
      WantedBy=timers.target

runcmd:
  - /usr/local/sbin/setup-mysql-tls-certs.sh
  - /usr/local/sbin/setup-group-replication.sh
  - /usr/local/sbin/setup-mysql-tls-accounts.sh
  - systemctl daemon-reload
  - systemctl enable --now quorum-watchdog.timer
