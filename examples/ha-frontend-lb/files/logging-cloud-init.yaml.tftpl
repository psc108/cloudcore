#cloud-config
# Centralized logging — single node running both Loki (log storage +
# query API) and Grafana (UI, pre-provisioned with Loki as its
# datasource). Deliberately not HA, same precedent as the single-node
# step-ca (haFullStack-LLD.md §5.1) — a Lab debugging aid, not part of
# the application's own critical path. No TLS — internal-only,
# bridge-subnet-scoped traffic between a debugging tool and the nodes
# it watches, same trust boundary this stack already draws for
# memcached (§3.3.1), not the application's own east-west path that
# earned the strict TLS-everywhere treatment elsewhere in this stack.
#
# Created early, alongside the CA node — every other tier's own
# promtail config needs this node's IP, same reasoning as the CA's own
# early creation.
#
# apt_preserve_sources_list / bootcmd — same host-level cloudcore-repo
# rewrite as every other tier; see ca-cloud-init.yaml.tftpl for the
# full rationale.
apt_preserve_sources_list: true
bootcmd:
  - |
    cat > /etc/apt/sources.list <<'EOF'
    deb [trusted=yes] http://192.168.100.1:8090/jammy/apt-repo ./
    EOF

package_update: true
packages:
  - grafana
  - loki
  - curl
  - ca-certificates

write_files:
  # Filesystem-backed single-node config — no S3/GCS needed at Lab
  # scale. Replaces the package's own example config entirely (that
  # default ships with settings meant to be edited before real use, not
  # a working out-of-the-box single-node setup).
  - path: /etc/loki/config.yml
    content: |
      auth_enabled: false

      server:
        http_listen_port: 3100
        grpc_listen_port: 9096

      common:
        path_prefix: /var/lib/loki
        storage:
          filesystem:
            chunks_directory: /var/lib/loki/chunks
            rules_directory: /var/lib/loki/rules
        replication_factor: 1
        ring:
          kvstore:
            store: inmemory

      schema_config:
        configs:
          - from: 2024-01-01
            store: tsdb
            object_store: filesystem
            schema: v13
            index:
              prefix: index_
              period: 24h

      limits_config:
        retention_period: 168h

  # Auto-provisioned datasource — no manual "Add data source" click
  # needed to reach a working Explore view, which is the whole point of
  # standing this up for people learning in the Lab.
  - path: /etc/grafana/provisioning/datasources/loki.yaml
    content: |
      apiVersion: 1
      datasources:
        - name: Loki
          type: loki
          access: proxy
          url: http://localhost:3100
          isDefault: true
          editable: true

  - path: /usr/local/sbin/setup-logging.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      set -euo pipefail

      # The loki .deb does not create its own data directory or own it
      # for the "loki" service user (confirmed via `dpkg -L loki` — no
      # var/lib entries at all) — unlike grafana's own package, which
      # does. Without this the service crash-loops on startup: "mkdir
      # /var/lib/loki: permission denied" (F-071). The loki system
      # user's own primary group is "nogroup" (no dedicated "loki"
      # group is created either), so that's what's used here.
      mkdir -p /var/lib/loki
      chown -R loki:nogroup /var/lib/loki

      systemctl enable --now loki
      systemctl restart loki

      # Grafana only applies grafana.ini's admin_password when it
      # creates the admin user on its OWN first-ever start — the
      # packages: stage above may already have auto-started
      # grafana-server with the package's own default config (admin/
      # admin) before this script gets a chance to edit anything, same
      # class of first-boot sequencing risk this stack has already hit
      # for MySQL root/RabbitMQ's Erlang cookie/Keystone's bootstrap.
      # Stop it and remove any already-created state first, so the
      # real first boot happens only once, against the correct config.
      systemctl stop grafana-server || true
      rm -f /var/lib/grafana/grafana.db

      python3 - <<'PYEOF'
      import configparser
      c = configparser.ConfigParser(strict=False)
      c.read('/etc/grafana/grafana.ini')
      if 'security' not in c:
          c['security'] = {}
      c['security']['admin_password'] = '${admin_password}'
      with open('/etc/grafana/grafana.ini', 'w') as f:
          c.write(f)
      PYEOF

      systemctl enable --now grafana-server
      systemctl restart grafana-server

runcmd:
  - /usr/local/sbin/setup-logging.sh
