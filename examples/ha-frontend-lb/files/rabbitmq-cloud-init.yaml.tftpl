#cloud-config
# RabbitMQ node. Clustering is asymmetric, unlike Keystone's active-active
# pair — a new node starts as its own single-node cluster by default;
# joining an existing one is an explicit, one-directional operation run
# on the JOINER against an already-running seed (haFullStack-LLD.md §4.1),
# same bootstrap/joiner shape as MySQL Group Replication. Only the seed's
# own IP is known to the joiners at apply time (modules/compute's per-key
# user_data can't reference that same module call's own IP outputs — see
# haFullStack-LLD.md §4.3.2/§2.3.2) — each node's own IP is detected at
# runtime (bridged instances only know it after boot), same pattern as
# MySQL's report_host / NGINX's Keepalived interface detection.
# apt_preserve_sources_list — without this, cloud-init's own apt-
# configure module regenerates /etc/apt/sources.list right after
# bootcmd runs, silently overwriting the cloudcore-repo rewrite below
# with zero error (confirmed directly, F-042, haFullStack-Findings-Log.md).
# bootcmd points apt at the host-level cloudcore-repo service
# (192.168.100.1:8090, haFullStack.md §14) instead of the real Ubuntu
# mirror; see ca-cloud-init.yaml.tftpl for the full rationale.
apt_preserve_sources_list: true
bootcmd:
  # cloudcore-repo is a host-level, always-on systemd service (not
  # per-project, no build-completion race to wait on like the old
  # NFS-based repo needed) — a plain HTTP GET, no client package to
  # install first the way NFS needed nfs-common, so the old
  # archive.ubuntu.com bootstrap fetch this block used to need is gone
  # entirely, not just relocated.
  - |
    cat > /etc/apt/sources.list <<'EOF'
    deb [trusted=yes] http://192.168.100.1:8090/jammy/apt-repo ./
    EOF

package_update: true
packages:
  - rabbitmq-server
  - curl
  - ca-certificates

write_files:
  # Every node in an Erlang cluster needs an identical cookie file, or
  # clustering is refused outright. Staged root-owned here, NOT written
  # directly to /var/lib/rabbitmq/ with owner: rabbitmq:rabbitmq —
  # cloud-init's write_files module runs before the packages stage, so
  # the rabbitmq system user doesn't exist yet at this point (same
  # F-026 lesson from Keystone's Fernet keys: an owner: on a not-yet-
  # existent user silently aborts the whole write_files module). Moved
  # into place with correct ownership in runcmd instead.
  - path: /root/erlang-cookie
    permissions: '0600'
    content: ${erlang_cookie}

  - path: /usr/local/sbin/setup-rabbitmq.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      set -euo pipefail

      LOCAL_IP=$(hostname -I | awk '{print $1}')

      systemctl stop rabbitmq-server

      mv /root/erlang-cookie /var/lib/rabbitmq/.erlang.cookie
      chown rabbitmq:rabbitmq /var/lib/rabbitmq/.erlang.cookie
      chmod 400 /var/lib/rabbitmq/.erlang.cookie

      # IP-based node identity, not the default hostname-based one —
      # deliberate choice over CloudCore's now-fixed guest DNS (F-022),
      # see haFullStack-LLD.md §4.1. RABBITMQ_USE_LONGNAME=true is
      # required alongside a dotted NODENAME — Erlang's default "short
      # name" mode rejects any name containing a dot, IP addresses
      # included ({:error, {:node_name, :short}} otherwise), confirmed
      # directly.
      cat > /etc/rabbitmq/rabbitmq-env.conf <<EOF
      NODENAME=rabbit@$LOCAL_IP
      RABBITMQ_USE_LONGNAME=true
      EOF

      systemctl start rabbitmq-server

      # rabbitmqctl needs the app fully up before any further commands —
      # cloud-init's own service start above returns once the process is
      # spawned, not once Mnesia/the rabbit application layer is ready.
      for i in $(seq 1 30); do
        rabbitmqctl status >/dev/null 2>&1 && break
        sleep 2
      done

      rabbitmq-plugins enable rabbitmq_management

      %{ if is_seed ~}
      # admin:admin — a deliberate, explicit Lab-only credential (same
      # convention as Keystone's admin:admin and every other credential
      # in this stack). Only needs to run once, here — RabbitMQ's user
      # database is shared cluster-wide via Mnesia once nodes join,
      # confirmed directly: a user created on the seed before any joiner
      # has clustered is still visible from the joiner immediately after
      # it joins, no separate propagation step needed.
      rabbitmqctl add_user admin admin
      rabbitmqctl set_user_tags admin administrator
      rabbitmqctl set_permissions -p / admin '.*' '.*' '.*'
      rabbitmqctl set_cluster_name rabbitmq-cluster

      # Application service accounts + vhost, per direct instruction —
      # ported from create_users.sh/create_vhost.sh, merged into one
      # combined step here rather than kept as separate scripts. Runs
      # only on the seed, same reasoning as admin: above. All 13 users
      # share one password, matching create_users.sh's own single-
      # positional-argument design and this stack's existing single-
      # shared-credential convention for Lab-only placeholders.
      for u in blobstore catalog customer event fulfillment pricing reporting request svcinst config export ticketing extevt; do
        rabbitmqctl add_user "$u" '${rabbitmq_services_password}'
      done

      rabbitmqctl add_vhost /ssp
      for u in blobstore catalog customer event fulfillment pricing reporting request svcinst config export ticketing extevt; do
        rabbitmqctl set_permissions -p /ssp "$u" '.*' '.*' '.*'
      done
      %{ else ~}
      # Wait for the seed to actually be up before attempting to join —
      # cloud-init on all 3 nodes runs concurrently, so the seed's own
      # setup above may not have finished yet (same risk MySQL's joiners
      # already guard against — haFullStack-LLD.md §2.3.1). rabbitmqctl
      # -n targets a remote node directly over Erlang distribution, which
      # only needs the cookie (already in place) and network reachability
      # (this SG's 4369/25672 rules) — confirmed working directly.
      for i in $(seq 1 180); do
        rabbitmqctl -n rabbit@${seed_ip} status >/dev/null 2>&1 && break
        sleep 5
      done

      rabbitmqctl stop_app
      rabbitmqctl join_cluster rabbit@${seed_ip}
      rabbitmqctl start_app
      %{ endif ~}

  # TLS/mTLS (haFullStack-LLD.md §5.3.1). A dedicated port (5671) that's
  # TLS from the first byte, unlike MySQL's in-band STARTTLS-style
  # upgrade — routed through NGINX's stream{} as a raw passthrough,
  # reusing the same rabbitmq_ips list as the existing plain :5672 entry.
  # cacertfile MUST be the root+intermediate chain concatenated, not just
  # the root — confirmed directly: Erlang's SSL stack rejects the client
  # cert with an "unknown ca" alert if only the root is present locally,
  # even though the client itself presents the intermediate (see
  # haFullStack-Findings-Log.md).
  - path: /usr/local/sbin/setup-rabbitmq-tls.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      set -euo pipefail

      LOCAL_IP=$(hostname -I | awk '{print $1}')

      curl -fsSL http://192.168.100.1:8090/jammy/artifacts/step-cli.deb -o /tmp/step-cli.deb
      echo "${step_cli_deb_sha256}  /tmp/step-cli.deb" | sha256sum -c -
      dpkg -i /tmp/step-cli.deb || apt-get install -f -y

      for i in $(seq 1 180); do
        curl -sf "http://${ca_ip}:8080/root_ca.crt" -o /tmp/root_ca.crt \
          && curl -sf "http://${ca_ip}:8080/intermediate_ca.crt" -o /tmp/intermediate_ca.crt \
          && break
        sleep 5
      done

      mkdir -p /etc/rabbitmq/ssl
      step ca certificate "$LOCAL_IP" /etc/rabbitmq/ssl/cert.pem /etc/rabbitmq/ssl/key.pem \
        --san "$LOCAL_IP" --san "${vip_address}" \
        --ca-url "https://${ca_ip}:8443" --root /tmp/root_ca.crt \
        --provisioner admin --provisioner-password-file <(echo -n "${ca_provisioner_password}") \
        --force
      cat /tmp/root_ca.crt /tmp/intermediate_ca.crt > /etc/rabbitmq/ssl/ca.crt
      cp /tmp/root_ca.crt /etc/rabbitmq/ssl/root_ca.crt
      chown -R rabbitmq:rabbitmq /etc/rabbitmq/ssl
      chmod 600 /etc/rabbitmq/ssl/key.pem

      cat > /etc/rabbitmq/rabbitmq.conf <<EOF
      listeners.ssl.default = 5671
      ssl_options.cacertfile = /etc/rabbitmq/ssl/ca.crt
      ssl_options.certfile = /etc/rabbitmq/ssl/cert.pem
      ssl_options.keyfile = /etc/rabbitmq/ssl/key.pem
      ssl_options.verify = verify_peer
      ssl_options.fail_if_no_peer_cert = true
      EOF

      systemctl restart rabbitmq-server

      for i in $(seq 1 30); do
        rabbitmqctl status >/dev/null 2>&1 && break
        sleep 2
      done

      # Positional <crt> <key> must come immediately after the subcommand,
      # before any flags — confirmed directly: flags-then-positional
      # fails with "too many positional arguments were provided". No
      # `step ca bootstrap` has been run here, so --ca-url/--root are
      # passed explicitly, same as the issuance call above.
      cat > /etc/systemd/system/step-renew.service <<EOF
      [Unit]
      Description=step-ca certificate auto-renewal daemon
      [Service]
      ExecStart=/usr/bin/step ca renew /etc/rabbitmq/ssl/cert.pem /etc/rabbitmq/ssl/key.pem --daemon --force --ca-url "https://${ca_ip}:8443" --root /etc/rabbitmq/ssl/root_ca.crt --exec "systemctl restart rabbitmq-server"
      Restart=always
      EOF
      systemctl daemon-reload
      systemctl enable --now step-renew

runcmd:
  - /usr/local/sbin/setup-rabbitmq.sh
  - /usr/local/sbin/setup-rabbitmq-tls.sh
