#cloud-config
# RabbitMQ node. Clustering is asymmetric, unlike Keystone's active-active
# pair — a new node starts as its own single-node cluster by default;
# joining an existing one is an explicit, one-directional operation run
# on the JOINER against an already-running seed (haFullStack-LLD.md §4.1),
# same bootstrap/joiner shape as MySQL Group Replication. Only the seed's
# own IP is known to the joiners at apply time (modules/compute's per-key
# user_data can't reference that same module call's own IP outputs — see
# haFullStack-LLD.md §4.3.2/§2.3.2) — each node's own IP is detected at
# runtime (bridged instances only know it after boot), same pattern as
# MySQL's report_host / NGINX's Keepalived interface detection.
# apt_preserve_sources_list — without this, cloud-init's own apt-
# configure module regenerates /etc/apt/sources.list right after
# bootcmd runs, silently overwriting the cloudcore-repo rewrite below
# with zero error (confirmed directly, F-042, haFullStack-Findings-Log.md).
# bootcmd points apt at the host-level cloudcore-repo service
# (192.168.100.1:8090, haFullStack.md §14) instead of the real Ubuntu
# mirror; see ca-cloud-init.yaml.tftpl for the full rationale.
apt_preserve_sources_list: true
bootcmd:
  # cloudcore-repo is a host-level, always-on systemd service (not
  # per-project, no build-completion race to wait on like the old
  # NFS-based repo needed) — a plain HTTP GET, no client package to
  # install first the way NFS needed nfs-common, so the old
  # archive.ubuntu.com bootstrap fetch this block used to need is gone
  # entirely, not just relocated.
  - |
    cat > /etc/apt/sources.list <<'EOF'
    deb [trusted=yes] http://192.168.100.1:8090/jammy/apt-repo ./
    EOF

package_update: true
packages:
  - rabbitmq-server
  - curl
  - ca-certificates
  - promtail
  - acl

write_files:
  # Centralized logging (haFullStack-LLD.md §12) — ships this node's own
  # journal + cloud-init-output.log to the host-level Loki service. __HOSTNAME__
  # fixed up in runcmd below, same sed-substitution idiom this stack
  # already uses for __IFACE__/__HOSTNAME__ elsewhere.
  - path: /etc/promtail/config.yml
    content: |
      ${indent(6, promtail_config)}

  # Every node in an Erlang cluster needs an identical cookie file, or
  # clustering is refused outright. Staged root-owned here, NOT written
  # directly to /var/lib/rabbitmq/ with owner: rabbitmq:rabbitmq —
  # cloud-init's write_files module runs before the packages stage, so
  # the rabbitmq system user doesn't exist yet at this point (same
  # F-026 lesson from Keystone's Fernet keys: an owner: on a not-yet-
  # existent user silently aborts the whole write_files module). Moved
  # into place with correct ownership in runcmd instead.
  - path: /root/erlang-cookie
    permissions: '0600'
    content: ${erlang_cookie}

  - path: /usr/local/sbin/setup-rabbitmq.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      set -euo pipefail

      LOCAL_IP=$(hostname -I | awk '{print $1}')

      systemctl stop rabbitmq-server

      mv /root/erlang-cookie /var/lib/rabbitmq/.erlang.cookie
      chown rabbitmq:rabbitmq /var/lib/rabbitmq/.erlang.cookie
      chmod 400 /var/lib/rabbitmq/.erlang.cookie

      # IP-based node identity, not the default hostname-based one —
      # deliberate choice over CloudCore's now-fixed guest DNS (F-022),
      # see haFullStack-LLD.md §4.1. RABBITMQ_USE_LONGNAME=true is
      # required alongside a dotted NODENAME — Erlang's default "short
      # name" mode rejects any name containing a dot, IP addresses
      # included ({:error, {:node_name, :short}} otherwise), confirmed
      # directly.
      cat > /etc/rabbitmq/rabbitmq-env.conf <<EOF
      NODENAME=rabbit@$LOCAL_IP
      RABBITMQ_USE_LONGNAME=true
      EOF

      systemctl start rabbitmq-server

      # rabbitmqctl needs the app fully up before any further commands —
      # cloud-init's own service start above returns once the process is
      # spawned, not once Mnesia/the rabbit application layer is ready.
      for i in $(seq 1 30); do
        rabbitmqctl status >/dev/null 2>&1 && break
        sleep 2
      done

      rabbitmq-plugins enable rabbitmq_management

      %{ if is_seed ~}
      # admin/var.admin_password — this stack's shared admin/service
      # credential (same convention as Keystone's bootstrap admin and
      # every other account in this stack, see variables.tf). Only needs
      # to run once, here — RabbitMQ's user database is shared cluster-
      # wide via Mnesia once nodes join, confirmed directly: a user
      # created on the seed before any joiner has clustered is still
      # visible from the joiner immediately after it joins, no separate
      # propagation step needed.
      rabbitmqctl add_user admin '${admin_password}'
      rabbitmqctl set_user_tags admin administrator
      rabbitmqctl set_permissions -p / admin '.*' '.*' '.*'
      rabbitmqctl set_cluster_name rabbitmq-cluster

      # Application service accounts + vhost, per direct instruction —
      # ported from create_users.sh/create_vhost.sh, merged into one
      # combined step here rather than kept as separate scripts. Runs
      # only on the seed, same reasoning as admin: above. All 13 users
      # share one password, matching create_users.sh's own single-
      # positional-argument design and this stack's existing single-
      # shared-credential convention for Lab-only placeholders.
      for u in blobstore catalog customer event fulfillment pricing reporting request svcinst config export ticketing extevt; do
        rabbitmqctl add_user "$u" '${rabbitmq_services_password}'
      done

      rabbitmqctl add_vhost /ssp
      for u in blobstore catalog customer event fulfillment pricing reporting request svcinst config export ticketing extevt; do
        rabbitmqctl set_permissions -p /ssp "$u" '.*' '.*' '.*'
      done
      %{ else ~}
      # Wait for the seed to actually be up before attempting to join —
      # cloud-init on all 3 nodes runs concurrently, so the seed's own
      # setup above may not have finished yet (same risk MySQL's joiners
      # already guard against — haFullStack-LLD.md §2.3.1). rabbitmqctl
      # -n targets a remote node directly over Erlang distribution, which
      # only needs the cookie (already in place) and network reachability
      # (this SG's 4369/25672 rules) — confirmed working directly.
      for i in $(seq 1 180); do
        rabbitmqctl -n rabbit@${seed_ip} status >/dev/null 2>&1 && break
        sleep 5
      done

      rabbitmqctl stop_app
      rabbitmqctl join_cluster rabbit@${seed_ip}
      rabbitmqctl start_app
      %{ endif ~}

  # TLS/mTLS (haFullStack-LLD.md §5.3.1), TLS-only per direct instruction
  # — no more plain :5672/:15672. `listeners.tcp = none` (the bare
  # top-level key, NOT listeners.tcp.default) is what actually disables
  # the plain AMQP listener — confirmed directly: listeners.tcp.default =
  # none fails cuttlefish's datatype validation ("none" cannot be
  # converted to a(n) integer), a hard boot failure, not a graceful
  # disable. The plain management HTTP listener needs no disabling
  # directive at all — simply never setting management.tcp.port (while
  # management.ssl.port is set) leaves only the HTTPS listener bound;
  # management.tcp.port = none hits the exact same datatype-validation
  # failure as listeners.tcp.default did. AMQP (5671) is a dedicated port
  # that's TLS from the first byte, unlike MySQL's in-band STARTTLS-style
  # upgrade; the management HTTPS API gets its own TLS listener (15671)
  # the same way — both routed through NGINX's stream{} as raw
  # passthroughs. management.ssl.* is a completely independent config
  # stanza from ssl_options.* (AMQP) — confirmed directly: setting
  # verify/fail_if_no_peer_cert here too (an initial attempt, matching
  # every other TLS surface in this stack) made the admin console
  # unreachable from a plain browser, which has no client cert to
  # present — the TLS handshake itself fails before RabbitMQ ever shows
  # a login page. Per direct instruction: management.ssl stays
  # server-TLS-only (encrypted, browser-reachable, username/password
  # auth as normal) while AMQP (ssl_options.*, below) keeps requiring a
  # client cert — real application connections, not a human in a
  # browser, use that one.
  # cacertfile MUST be the root+intermediate chain concatenated, not just
  # the root — confirmed directly: Erlang's SSL stack rejects the client
  # cert with an "unknown ca" alert if only the root is present locally,
  # even though the client itself presents the intermediate (see
  # haFullStack-Findings-Log.md).
  #
  # Paths (/etc/rabbitmq/{ca.crt,server.crt,server.key}, flat — not nested
  # under an ssl/ subdirectory) and the rabbitmq.conf shape below (including
  # heartbeat/log.file.level) match this project's own real-world RabbitMQ
  # convention, per direct instruction, rather than an arbitrary Lab choice.
  #
  # server.key is passphrase-protected with var.admin_password — step ca
  # certificate issues an unencrypted key by default, so it's re-encrypted
  # in place immediately after issuance (and again after every renewal,
  # via step-renew.service's --exec hook below) with `openssl pkey`, not
  # the older key-type-specific `openssl rsa`/`openssl ec` — step-ca's
  # default provisioner issues an EC key, and `pkey` handles either
  # uniformly without needing to know which.
  - path: /usr/local/sbin/setup-rabbitmq-tls.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      set -euo pipefail

      LOCAL_IP=$(hostname -I | awk '{print $1}')

      curl -fsSL http://192.168.100.1:8090/jammy/artifacts/step-cli.deb -o /tmp/step-cli.deb
      echo "${step_cli_deb_sha256}  /tmp/step-cli.deb" | sha256sum -c -
      dpkg -i /tmp/step-cli.deb || apt-get install -f -y

      for i in $(seq 1 180); do
        curl -sf "http://${ca_ip}:8080/root_ca.crt" -o /tmp/root_ca.crt \
          && curl -sf "http://${ca_ip}:8080/intermediate_ca.crt" -o /tmp/intermediate_ca.crt \
          && break
        sleep 5
      done

      step ca certificate "$LOCAL_IP" /etc/rabbitmq/server.crt /etc/rabbitmq/server.key \
        --san "$LOCAL_IP" --san "${vip_address}" \
        --ca-url "https://${ca_ip}:8443" --root /tmp/root_ca.crt \
        --provisioner admin --provisioner-password-file <(echo -n "${ca_provisioner_password}") \
        --force
      # -in and -out must NOT be the same path — openssl truncates -out
      # before it's finished reading -in, corrupting the key (confirmed
      # directly: "Could not read key from ..." on the very next read).
      # Write to a temp file, then move it into place.
      openssl pkey -aes256 -in /etc/rabbitmq/server.key -out /etc/rabbitmq/server.key.enc \
        -passout pass:'${admin_password}'
      mv /etc/rabbitmq/server.key.enc /etc/rabbitmq/server.key
      cat /tmp/root_ca.crt /tmp/intermediate_ca.crt > /etc/rabbitmq/ca.crt
      cp /tmp/root_ca.crt /etc/rabbitmq/root_ca.crt
      chown rabbitmq:rabbitmq /etc/rabbitmq/ca.crt /etc/rabbitmq/server.crt /etc/rabbitmq/server.key /etc/rabbitmq/root_ca.crt
      chmod 600 /etc/rabbitmq/server.key

      # Plain-content password file for `step ca renew --password-file`
      # below (see step-renew.service's own ExecStart) — without it,
      # step ca renew has no way to decrypt the already-encrypted
      # server.key to prove possession for the renewal CSR and fails
      # immediately with "error loading private key: : no such device or
      # address" on every invocation, confirmed directly (F-070,
      # haFullStack-Findings-Log.md) — Restart=always exhausts systemd's
      # burst limit within seconds and the unit ends up permanently
      # failed, silently breaking auto-renewal from the very first boot.
      echo -n "${admin_password}" > /etc/rabbitmq/server.key.passfile
      chown rabbitmq:rabbitmq /etc/rabbitmq/server.key.passfile
      chmod 600 /etc/rabbitmq/server.key.passfile

      cat > /etc/rabbitmq/rabbitmq.conf <<EOF
      listeners.ssl.default = 5671
      ssl_options.cacertfile = /etc/rabbitmq/ca.crt
      ssl_options.certfile = /etc/rabbitmq/server.crt
      ssl_options.keyfile = /etc/rabbitmq/server.key
      ssl_options.password = ${admin_password}
      ssl_options.verify = verify_peer
      ssl_options.fail_if_no_peer_cert = true
      management.ssl.port = 15671
      management.ssl.certfile = /etc/rabbitmq/server.crt
      management.ssl.keyfile = /etc/rabbitmq/server.key
      management.ssl.password = ${admin_password}
      heartbeat = 580
      log.file.level = info
      listeners.tcp = none
      EOF

      systemctl restart rabbitmq-server

      for i in $(seq 1 30); do
        rabbitmqctl status >/dev/null 2>&1 && break
        sleep 2
      done

      # Positional <crt> <key> must come immediately after the subcommand,
      # before any flags — confirmed directly: flags-then-positional
      # fails with "too many positional arguments were provided". No
      # `step ca bootstrap` has been run here, so --ca-url/--root are
      # passed explicitly, same as the issuance call above. Re-encrypts
      # the freshly-renewed (and therefore freshly-unencrypted) key before
      # restarting the server, same as the initial issuance above —
      # without this, a renewal would silently leave rabbitmq-server
      # trying to read an encrypted-key config against a now-plaintext
      # key file.
      cat > /etc/systemd/system/step-renew.service <<EOF
      [Unit]
      Description=step-ca certificate auto-renewal daemon
      [Service]
      ExecStart=/usr/bin/step ca renew /etc/rabbitmq/server.crt /etc/rabbitmq/server.key --password-file /etc/rabbitmq/server.key.passfile --daemon --force --ca-url "https://${ca_ip}:8443" --root /etc/rabbitmq/root_ca.crt --exec "openssl pkey -aes256 -in /etc/rabbitmq/server.key -passin pass:'${admin_password}' -out /etc/rabbitmq/server.key.enc -passout pass:'${admin_password}' && mv /etc/rabbitmq/server.key.enc /etc/rabbitmq/server.key && systemctl restart rabbitmq-server"
      Restart=always
      EOF
      systemctl daemon-reload
      systemctl enable --now step-renew

runcmd:
  # F-073/F-072 promtail fix, first — before setup-rabbitmq.sh starts
  # rabbitmq-server. See ca-cloud-init.yaml.tftpl's own runcmd comment
  # for the full reasoning (F-076, haFullStack-Findings-Log.md):
  # running this after a tier's own service-setup steps left a real
  # window where promtail's still-__HOSTNAME__-labeled postinst-started
  # instance could already be shipping that service's own log file
  # under the wrong label. The "rabbitmq" group already exists at this
  # point — created by the rabbitmq-server package's own postinst
  # during cloud-init's earlier packages: phase, well before runcmd
  # ever starts — so usermod doesn't need the service itself running
  # first.
  - systemctl stop promtail || true
  - sed "s/__HOSTNAME__/$(hostname)/" -i /etc/promtail/config.yml
  - usermod -aG adm promtail
  # RabbitMQ's own log files (/var/log/rabbitmq/rabbit@*.log) are
  # group-owned "rabbitmq", not "adm" — confirmed live via a real
  # "permission denied" from promtail without this. No credential
  # material lives in this directory (unlike proxysql's own datadir),
  # so group membership is a fine, simple fix here.
  - usermod -aG rabbitmq promtail
  - systemctl enable --now promtail
  - /usr/local/sbin/setup-rabbitmq.sh
  - /usr/local/sbin/setup-rabbitmq-tls.sh
  # rabbitmq-server's own systemd unit redirects its stdout/stderr
  # directly to these two files (StandardOutput=append:.../
  # rabbitmq-server.log, StandardError=append:.../rabbitmq-server.
  # error.log) — unlike rabbit@*.log (written by RabbitMQ's own
  # Erlang runtime as the rabbitmq user, covered by the usermod -aG
  # rabbitmq above), systemd creates these as root:root 640 regardless
  # of the unit's own User=/Group=, confirmed live (F-079,
  # haFullStack-Findings-Log.md). No group covers "root" short of
  # actually granting promtail root-adjacent access, so this is a
  # file-specific ACL instead — same reasoning and pattern as
  # proxysql's own setfacl step above. No credential material lives
  # here (confirmed directly: just RabbitMQ's own startup banner and
  # feature-flag notices before it hands off to its own rabbit@*.log
  # handler), so this is a plain read grant, nothing more sensitive to
  # scope around. Placed after setup-rabbitmq-tls.sh's own final
  # restart so the ACL applies to the files the running process
  # actually holds open.
  - setfacl -m u:promtail:r /var/log/rabbitmq/rabbitmq-server.log /var/log/rabbitmq/rabbitmq-server.error.log
