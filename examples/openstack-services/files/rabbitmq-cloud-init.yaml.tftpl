#cloud-config
# RabbitMQ: plain rabbitmq-server, matching the Ansible port's own
# minimal illustrative install (08-openstack-services.yml) — this
# OpenTofu version previously created this instance with no
# cloud-init at all, a real IaC-front-end parity gap fixed alongside
# the promtail addition below, not a pre-existing design choice worth
# keeping.
#
# apt_preserve_sources_list + bootcmd point this guest at the
# host-level package repo (api/build-package-repo.sh,
# haFullStack.md §14) exclusively, the same pattern every other
# example uses.
apt_preserve_sources_list: true
bootcmd:
  - |
    cat > /etc/apt/sources.list <<'EOF'
    deb [trusted=yes] http://192.168.100.1:8090/jammy/apt-repo ./
    EOF

package_update: true
packages:
  - rabbitmq-server
  - promtail
  - acl

write_files:
  # Centralized logging (haFullStack-LLD.md §12) — ships this node's
  # own journal, cloud-init-output.log, and RabbitMQ's own log files
  # to the host-level Loki service. __HOSTNAME__ fixed up in runcmd
  # below, same sed-substitution idiom this platform already uses
  # elsewhere.
  - path: /etc/promtail/config.yml
    content: |
      ${indent(6, promtail_config)}

runcmd:
  # F-073/F-072 promtail fix, first, before rabbitmq-server starts
  # (F-076, haFullStack-Findings-Log.md — promtail's own package
  # postinst auto-starts it immediately once installed, before this
  # runcmd block gets a chance to fix up __HOSTNAME__ or grant the
  # "adm" group needed to read root:adm 0640
  # /var/log/cloud-init-output.log).
  - systemctl stop promtail || true
  - sed "s/__HOSTNAME__/$(hostname)/" -i /etc/promtail/config.yml
  - usermod -aG adm promtail
  # RabbitMQ's own log files are group-owned "rabbitmq", not "adm"
  # (F-074, haFullStack-Findings-Log.md) — confirmed live via a real
  # "permission denied" from promtail without this on ha-frontend-lb's
  # own RabbitMQ tier. No credential material lives in this
  # directory, so group membership is a fine, simple fix here.
  - usermod -aG rabbitmq promtail
  - systemctl enable --now promtail
  - systemctl enable --now rabbitmq-server
  # rabbitmq-server's own systemd unit redirects its stdout/stderr
  # directly to these two files (StandardOutput=append:.../
  # rabbitmq-server.log, StandardError=append:.../rabbitmq-server.
  # error.log) — unlike rabbit@*.log (written by RabbitMQ's own
  # Erlang runtime as the rabbitmq user, covered by the usermod -aG
  # rabbitmq above), systemd creates these as root:root 640 regardless
  # of the unit's own User=/Group=, confirmed live (F-079,
  # haFullStack-Findings-Log.md). No group covers "root" short of
  # actually granting promtail root-adjacent access, so this is a
  # file-specific ACL instead. No credential material lives here
  # (confirmed directly: just RabbitMQ's own startup banner and
  # feature-flag notices before it hands off to its own rabbit@*.log
  # handler), so this is a plain read grant, nothing more sensitive to
  # scope around.
  - setfacl -m u:promtail:r /var/log/rabbitmq/rabbitmq-server.log /var/log/rabbitmq/rabbitmq-server.error.log
