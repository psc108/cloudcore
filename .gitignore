.idea/
*.iml

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# Go
provider/terraform-provider-cloudcore

# OpenTofu state
**/.terraform/
**/terraform.tfstate
**/terraform.tfstate.backup

# Ansible build artefacts
ansible/collections/cloudcore/*.tar.gz

# DB and runtime
api/cloudcore.db
api/cloudcore.db-wal
api/cloudcore.db-shm
api/images/
api/instances/
api/volumes/
api/package-repo/*
!api/package-repo/README.md
# Whole directory, not just the original SSH keypair's two filenames —
# cross-host peering added its own ed25519 identity keypair and will add
# a WireGuard keypair too (api/identity.py); every file generated here is
# host-specific key material, never meant to be committed, regardless of
# how many more get added over time.
api/keys/
*.migrated

# Test results
tests/results/

# Editor
*.swp
*.swo

# HAProxy runtime configs and pids
api/lb/*.cfg
api/lb/*.pid
api/lb/*.sock

# DNS server runtime (generated dnsmasq.conf/pid)
api/dns/
.amazonq/

# Ansible example-generated secrets (idempotent local state, not committed)
ansible/examples/.state/
